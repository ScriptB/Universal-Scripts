_safeUI("Info Player", function()
    local thumbUrl = ""
    pcall(function()
        thumbUrl = Players:GetUserThumbnailAsync(
            plr.UserId,
            Enum.ThumbnailType.HeadShot,
            Enum.ThumbnailSize.Size150x150
        )
    end)

    if thumbUrl and thumbUrl ~= "" then
        local avatarLbl = Info_Player:AddLabel("Avatar:")
        pcall(function()
            avatarLbl.Text = ""
            avatarLbl.Size = UDim2.new(1, 0, 0, 80)
            local img = Instance.new("ImageLabel")
            img.Image              = thumbUrl
            img.Size               = UDim2.new(0, 72, 0, 72)
            img.Position           = UDim2.new(0.5, -36, 0, 4)
            img.BackgroundColor3   = Color3.fromRGB(30, 30, 35)
            img.BackgroundTransparency = 0
            img.BorderSizePixel    = 0
            img.ScaleType          = Enum.ScaleType.Fit
            img.Parent             = avatarLbl
            local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 36); corner.Parent = img
            local stroke = Instance.new("UIStroke"); stroke.Thickness = 2; stroke.Color = Color3.fromRGB(0, 170, 255); stroke.Parent = img
        end)
    end

    Info_Player:AddLabel("Username: " .. plr.Name)
    Info_Player:AddLabel("Display: " .. plr.DisplayName)
    Info_Player:AddLabel("User ID: " .. tostring(plr.UserId))
    Info_Player:AddDivider()
    Info_Player:AddLabel("Account Age: " .. tostring(plr.AccountAge) .. " days")
    Info_Player:AddButton({ Text = "Copy User ID", Callback = function()
        _sfx(SFX.Success, 0.35)
        pcall(function() setclipboard(tostring(plr.UserId)) end)
        AxiUI:Notify("Raycast", "User ID copied", 2)
    end })
end)

_safeUI("Info Session", function()
    local startTime    = os.time()
    local sessionLabel = Info_Session:AddLabel("Uptime: 0s")
    Info_Session:AddLabel("Started: " .. os.date("%H:%M:%S"))
    Info_Session:AddLabel("Date: " .. os.date("%Y-%m-%d"))
    Info_Session:AddDivider()
    Info_Session:AddLabel("Hooks: Namecall + Index")
    Info_Session:AddLabel("Anti-Cheat: Monitoring")

    task.spawn(function()
        while not _unloaded do
            local elapsed = os.time() - startTime
            local m, s = math.floor(elapsed / 60), elapsed % 60
            pcall(function()
                if sessionLabel and sessionLabel.Parent then
                    sessionLabel.Text = string.format("Uptime: %dm %02ds", m, s)
                end
            end)
            task.wait(1)
        end
    end)
end)

_safeUI("Info Game", function()
    local placeId = game.PlaceId
    local gameId  = game.GameId
    local jobId   = game.JobId
    _sfx(SFX.Select, 0.2, 1.1)

    Info_Game:AddLabel("Place ID: " .. tostring(placeId))
    Info_Game:AddLabel("Game ID: " .. tostring(gameId))
    Info_Game:AddDivider()

    local pName = "Unknown"
    pcall(function()
        local info = game:GetService("MarketplaceService"):GetProductInfo(placeId)
        if info and info.Name then pName = info.Name end
    end)
    Info_Game:AddLabel("Game: " .. pName)
    Info_Game:AddLabel("Players: " .. tostring(#Players:GetPlayers()) .. "/" .. tostring(Players.MaxPlayers))

    Info_Game:AddButton({ Text = "Copy Job ID", Callback = function()
        _sfx(SFX.Success, 0.35)
        pcall(function() setclipboard(jobId) end)
        AxiUI:Notify("Raycast", "Job ID copied", 2)
    end })
    local _rjClicks = 0
    Info_Game:AddButton({ Text = "Rejoin Server (click twice)", Callback = function()
        _rjClicks = _rjClicks + 1
        if _rjClicks >= 2 then
            _sfx(SFX.Alert, 0.4)
            pcall(function() game:GetService("TeleportService"):TeleportToPlaceInstance(placeId, jobId) end)
            _rjClicks = 0
        else
            AxiUI:Notify("Rejoin", "Click again to confirm", 2)
            task.delay(2, function() _rjClicks = 0 end)
        end
    end })
end)

_safeUI("Info Executor", function()
    local execName = "Unknown"
    pcall(function()
        if identifyexecutor then
            local name, ver = identifyexecutor()
            execName = name .. (ver and (" " .. ver) or "")
        elseif getexecutorname then
            execName = getexecutorname()
        end
    end)
    Info_Executor:AddLabel("Executor: " .. execName)

    local identity = "?"
    pcall(function()
        if getthreadidentity then identity = tostring(getthreadidentity())
        elseif getidentity    then identity = tostring(getidentity()) end
    end)
    Info_Executor:AddLabel("Identity Level: " .. identity)
    Info_Executor:AddDivider()

    local checks = {
        { "hookmetamethod",    hookmetamethod    },
        { "hookfunction",      hookfunction      },
        { "newcclosure",       newcclosure       },
        { "getrawmetatable",   getrawmetatable   },
        { "setclipboard",      setclipboard      },
        { "firetouchinterest", firetouchinterest },
    }
    local supported = 0
    for _, c in ipairs(checks) do if c[2] then supported = supported + 1 end end
    Info_Executor:AddLabel("UNC Coverage: " .. supported .. "/" .. #checks)

    Info_Executor:AddButton({ Text = "Copy Executor Info", Callback = function()
        _sfx(SFX.Success, 0.35)
        local txt = "Executor: " .. execName .. " | Identity: " .. identity .. " | UNC: " .. supported .. "/" .. #checks
        pcall(function() setclipboard(txt) end)
        AxiUI:Notify("Raycast", "Executor info copied", 2)
    end })
end)

_safeUI("Info Performance", function()
    local memLabel  = Info_Perf:AddLabel("Memory: calculating...")
    local fpsLabel  = Info_Perf:AddLabel("FPS: calculating...")
    Info_Perf:AddDivider()
    local pingLabel = Info_Perf:AddLabel("Ping: calculating...")
    local StatsService = game:GetService("Stats")

    task.spawn(function()
        while not _unloaded do
            pcall(function()
                local mem = math.floor(gcinfo() / 1024 * 10) / 10
                if memLabel and memLabel.Parent then memLabel.Text = "Memory: " .. tostring(mem) .. " MB" end
            end)
            pcall(function()
                local fps = math.floor(1 / game:GetService("RunService").RenderStepped:Wait())
                if fpsLabel and fpsLabel.Parent then fpsLabel.Text = "FPS: " .. tostring(fps) end
            end)
            pcall(function()
                local ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
                if pingLabel and pingLabel.Parent then pingLabel.Text = "Ping: " .. tostring(ping) .. " ms" end
            end)
            task.wait(1)
        end
    end)

    Info_Perf:AddButton({ Text = "Force Garbage Collect", Callback = function()
        _sfx(SFX.Select, 0.3)
        pcall(function() collectgarbage("collect") end)
        AxiUI:Notify("Raycast", "GC cycle triggered", 2)
    end })
end)

-- ═══════════════════════════════════════════════════════════════════════════
--  STARTUP
-- ═══════════════════════════════════════════════════════════════════════════

AxiUI:Notify("Raycast v3", "Loaded — all hooks active. Toggle: RightShift", 4)

if type(_savedIndexHook) == "function" then
    pcall(hookmetamethod, game, "__index", _savedIndexHook)
end

print("[Raycast | v3] Loaded — AxiUI active, hooks re-installed. Toggle: RightShift")

end)() -- end UI scope

end -- _RaycastMain
