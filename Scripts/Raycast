-- ============================================================================
-- 🔐 KEY SYSTEM  (GrantFlow style — customised for Raycast | v3)
-- ============================================================================

-- Forward-declare so the key-system do-block can reference it via task.defer.
local _RaycastMain

do -- key-system block (scoped so locals don't leak)
    local _TweenService  = game:GetService("TweenService")
    local _HttpService   = game:GetService("HttpService")
    local _LocalPlayer   = game:GetService("Players").LocalPlayer
    local _CoreGui       = (gethui and gethui()) or game:GetService("CoreGui")
    local _SoundService  = game:GetService("SoundService")
    local _Debris        = game:GetService("Debris")

    -- Key config and hash live here so nothing runs at chunk level.
    -- bit32 is available here because game:GetService succeeded above.
    local function _fnv1a(s)
        local h = 2166136261
        for i = 1, #s do
            h = bit32.bxor(h, string.byte(s, i))
            h = (h * 16777619) % 4294967296
        end
        return h
    end
    local _rawKey   = "wnAZC41LM3875j1jQoa62xhc9rTqkL1Y"
    local _KEY_HASH = _fnv1a(_rawKey)
    _rawKey = nil
    local _KEY_CONFIG = {
        Discord        = "https://discord.gg/h95Xvas2GJ",
        AppName        = "Raycast | v3",
        WebhookLogging = false,
        WebhookURL     = "",
        Theme = {
            Background   = Color3.fromRGB(10, 10, 12),
            Accent       = Color3.fromRGB(0, 170, 255),
            Secondary    = Color3.fromRGB(20, 20, 25),
            Text         = Color3.fromRGB(255, 255, 255),
            Transparency = 0.08,
            Stroke       = 2,
        },
        Anim = {
            IntroType  = "Slide",
            Style      = "Elastic",
            Duration   = 1.0,
            WaitBuffer = 0.4,
        },
    }
    local _theme         = _KEY_CONFIG.Theme
    local _anim          = _KEY_CONFIG.Anim

    -- Tween helper
    local function _tween(obj, t, goal, style)
        local ti = TweenInfo.new(t, style or Enum.EasingStyle.Sine)
        local tw = _TweenService:Create(obj, ti, goal)
        tw:Play(); return tw
    end

    -- Key-system SFX (fires before Library loads — uses raw SoundService)
    -- IDs: click=17779566040  tick=138800001279918  hover=116271631941040  notify=79130903404606  whoosh=137081214744553
    local function _ksSound(id, vol, pitch)
        if not id or id == 0 then return end
        pcall(function()
            local s = Instance.new("Sound")
            s.SoundId         = "rbxassetid://" .. tostring(id)
            s.Volume          = vol   or 0.5
            s.PlaybackSpeed   = pitch or 1.0
            s.RollOffMaxDistance = 0
            s.Parent          = _SoundService
            s:Play()
            _Debris:AddItem(s, 4)
        end)
    end

    -- Slide / zoom / fade intro–outro
    local function _applyAnim(obj, isOutro)
        local d = _anim.Duration or 0.7
        local s = Enum.EasingStyle[_anim.Style] or Enum.EasingStyle.Elastic
        local tp = _anim.IntroType
        if tp == "Slide" then
            local base = obj.Position
            if not isOutro then
                obj.Position = UDim2.new(base.X.Scale, base.X.Offset, 1.5, 0)
                _tween(obj, d, {Position = base}, s)
            else
                _tween(obj, d, {Position = UDim2.new(base.X.Scale, base.X.Offset, -1.5, 0)}, s)
            end
        elseif tp == "Zoom" then
            if not isOutro then
                local sz = obj.Size; obj.Size = UDim2.fromScale(0, 0)
                _tween(obj, d, {Size = sz}, s)
            else
                _tween(obj, d, {Size = UDim2.fromScale(0, 0)}, s)
            end
        else -- fade
            if not isOutro then
                obj.BackgroundTransparency = 1
                _tween(obj, d, {BackgroundTransparency = _theme.Transparency}, s)
            else
                _tween(obj, d, {BackgroundTransparency = 1}, s)
            end
        end
    end

    -- Optional webhook
    local function _sendWebhook()
        if not _KEY_CONFIG.WebhookLogging or _KEY_CONFIG.WebhookURL == "" then return end
        pcall(function()
            local req = request or (http and http.request) or nil
            if not req then return end
            req({
                Url    = _KEY_CONFIG.WebhookURL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body   = _HttpService:JSONEncode({
                    embeds = {{
                        title       = "Raycast | v3 — Execution",
                        color       = 0x00AAFF,
                        fields      = {
                            {name="Player",  value=_LocalPlayer.Name,            inline=true},
                            {name="User ID", value=tostring(_LocalPlayer.UserId), inline=true},
                            {name="Profile", value="https://www.roblox.com/users/".._LocalPlayer.UserId.."/profile"},
                            {name="Time",    value=os.date("%X"),                inline=true},
                        },
                        footer = {text = "Raycast v3 Key Logger"},
                    }},
                }),
            })
        end)
    end

    -- Handshake splash — scan-line sweep + accent pulse
    local function _showHandshake(cb)
        task.spawn(_sendWebhook)
        _ksSound(137081214744553, 0.3, 0.92)    -- soft whoosh on startup

        local sg = Instance.new("ScreenGui"); sg.Name = "RCv3_Handshake"; sg.Parent = _CoreGui
        local bg = Instance.new("Frame", sg)
        bg.Size = UDim2.fromScale(1,1)
        bg.BackgroundColor3 = _theme.Background; bg.BorderSizePixel = 0; bg.ZIndex = 100

        -- Vertical accent scan-line sweeps across the screen before text appears
        local scan = Instance.new("Frame", bg)
        scan.Size = UDim2.new(0, 3, 1, 0)
        scan.Position = UDim2.fromScale(-0.02, 0)
        scan.BackgroundColor3 = _theme.Accent
        scan.BorderSizePixel = 0; scan.ZIndex = 102
        local scanGrad = Instance.new("UIGradient", scan)
        scanGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Color3.new(1,1,1)),
            ColorSequenceKeypoint.new(0.5, _theme.Accent),
            ColorSequenceKeypoint.new(1,   Color3.new(1,1,1)),
        })
        scanGrad.Rotation = 90

        -- Faint horizontal grid-lines for hacker aesthetic
        for row = 1, 6 do
            local line = Instance.new("Frame", bg)
            line.Size      = UDim2.new(1, 0, 0, 1)
            line.Position  = UDim2.fromScale(0, row / 7)
            line.BackgroundColor3 = _theme.Accent
            line.BackgroundTransparency = 0.88
            line.BorderSizePixel = 0; line.ZIndex = 101
        end

        local lbl = Instance.new("TextLabel", bg)
        lbl.Size = UDim2.fromScale(1, 1); lbl.BackgroundTransparency = 1
        lbl.Text = "Raycast | v3  ·  LOADING..."
        lbl.TextColor3 = _theme.Accent; lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 15
        lbl.TextTransparency = 1; lbl.TextWrapped = true; lbl.ZIndex = 103

        -- Sweep scan-line across, THEN fade in text
        _tween(scan, 0.55, {Position = UDim2.fromScale(1.02, 0)}, Enum.EasingStyle.Quad)
        task.wait(0.35)
        _tween(lbl, 0.45, {TextTransparency = 0})
        task.wait(1.1)

        -- Brief bright flash before exit
        _tween(lbl, 0.12, {TextColor3 = Color3.new(1, 1, 1)})
        task.wait(0.13)
        _tween(lbl, 0.12, {TextColor3 = _theme.Accent})
        task.wait(0.12)
        local t = _tween(lbl, 0.35, {TextTransparency = 1})
        _tween(bg, 0.7, {BackgroundTransparency = 1})
        t.Completed:Wait()
        sg:Destroy(); if cb then cb() end
    end

    -- Loading screen (shown after successful auth)
    local function _showLoading(cb)
        _ksSound(116271631941040, 0.3, 1.06)   -- soft chime on appear

        local sg = Instance.new("ScreenGui"); sg.Name = "RCv3_Loading"; sg.Parent = _CoreGui
        local main = Instance.new("Frame", sg)
        main.Size = UDim2.fromOffset(340, 110)
        -- Start below screen, slide up with Back easing
        main.Position = UDim2.new(0.5, 0, 1.3, 0)
        main.AnchorPoint = Vector2.new(0.5, 0.5)
        main.BackgroundColor3 = _theme.Background
        main.BackgroundTransparency = _theme.Transparency
        main.BorderSizePixel = 0; main.ClipsDescendants = false
        Instance.new("UICorner", main).CornerRadius = UDim.new(0, 8)
        _tween(main, 0.45, {Position = UDim2.fromScale(0.5, 0.5)}, Enum.EasingStyle.Back)

        local stk = Instance.new("UIStroke", main); stk.Color = _theme.Accent; stk.Thickness = _theme.Stroke
        -- Stroke glow loop while loading — chained via Completed, no task.wait loop.
        local _glowActive = true
        local _glowConn
        local function _doGlow(toWhite)
            if not _glowActive then return end
            local goal = toWhite
                and {Color = Color3.new(1, 1, 1), Thickness = 2}
                or  {Color = _theme.Accent, Thickness = _theme.Stroke}
            local tw = _tween(stk, 0.55, goal)
            if _glowConn then _glowConn:Disconnect() end
            _glowConn = tw.Completed:Connect(function()
                if _glowActive then _doGlow(not toWhite) end
            end)
        end
        _doGlow(true)

        local status = Instance.new("TextLabel", main)
        status.Size = UDim2.new(1, -24, 0, 56); status.Position = UDim2.fromOffset(12, 4)
        status.BackgroundTransparency = 1; status.TextColor3 = _theme.Text
        status.Font = Enum.Font.GothamMedium; status.TextSize = 13
        status.TextWrapped = true; status.TextXAlignment = Enum.TextXAlignment.Left

        local pctLbl = Instance.new("TextLabel", main)
        pctLbl.Size = UDim2.new(0, 44, 0, 20); pctLbl.Position = UDim2.new(1, -54, 0, 4)
        pctLbl.BackgroundTransparency = 1; pctLbl.TextColor3 = _theme.Accent
        pctLbl.Font = Enum.Font.GothamBold; pctLbl.TextSize = 11
        pctLbl.TextXAlignment = Enum.TextXAlignment.Right; pctLbl.Text = "0%"

        local barBG = Instance.new("Frame", main)
        barBG.Size = UDim2.new(1, -24, 0, 5); barBG.Position = UDim2.fromOffset(12, 88)
        barBG.BackgroundColor3 = _theme.Secondary; barBG.BorderSizePixel = 0
        Instance.new("UICorner", barBG).CornerRadius = UDim.new(1, 0)

        local bar = Instance.new("Frame", barBG)
        bar.Size = UDim2.fromScale(0, 1); bar.BackgroundColor3 = _theme.Accent
        bar.BorderSizePixel = 0
        Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

        -- Leading glow dot on rightmost edge of bar
        local glow = Instance.new("Frame", bar)
        glow.Size = UDim2.new(0, 10, 2, -2); glow.Position = UDim2.new(1, -5, -0.5, 1)
        glow.AnchorPoint = Vector2.new(0.5, 0)
        glow.BackgroundColor3 = Color3.new(1, 1, 1)
        glow.BackgroundTransparency = 0.35; glow.BorderSizePixel = 0; glow.ZIndex = 6
        Instance.new("UICorner", glow).CornerRadius = UDim.new(1, 0)

        task.spawn(function()
            local stages = {
                {txt = "VERIFYING TOKEN...",  pct = 0.25, pitch = 1.00},
                {txt = "SYNCING MODULES...",  pct = 0.50, pitch = 1.05},
                {txt = "BUILDING HOOKS...",   pct = 0.75, pitch = 1.10},
                {txt = "READY.",              pct = 1.00, pitch = 1.16},
            }
            -- Accent colour brightens as bar fills: pure accent → white-shifted
            local aR, aG, aB = _theme.Accent.R * 255, _theme.Accent.G * 255, _theme.Accent.B * 255
            for _, st in ipairs(stages) do
                _ksSound(17779566040, 0.32, st.pitch)   -- click pop per stage
                status.Text  = st.txt
                pctLbl.Text  = math.floor(st.pct * 100) .. "%"
                local t = st.pct
                _tween(bar, 0.42, {
                    Size             = UDim2.fromScale(t, 1),
                    BackgroundColor3 = Color3.fromRGB(
                        math.min(255, math.floor(aR + (255 - aR) * t * 0.6)),
                        math.min(255, math.floor(aG + (255 - aG) * t * 0.6)),
                        math.min(255, math.floor(aB + (255 - aB) * t * 0.6))
                    ),
                })
                task.wait(0.52)
            end
            _glowActive = false
            _ksSound(79130903404606, 0.45, 1.08)   -- success chime on finish
            _tween(stk, 0.2, {Color = Color3.fromRGB(30, 220, 100), Thickness = 2})
            task.wait(0.25)
            _tween(main, 0.3, {BackgroundTransparency = 1})
            task.wait(0.35)
            sg:Destroy(); if cb then cb() end
        end)
    end

    -- Auth gate
    local function _initAuth(successCb)
        -- Reset the attempt counter each time the auth GUI opens so a
        -- re-execute always starts with a fresh 5-attempt allowance.
        getgenv()._RCv3_AuthAttempts = nil
        local sg = Instance.new("ScreenGui"); sg.Name = "RCv3_Auth"; sg.Parent = _CoreGui
        local main = Instance.new("Frame", sg)
        main.Size = UDim2.fromOffset(360, 290)
        main.Position = UDim2.fromScale(0.5,0.5); main.AnchorPoint = Vector2.new(0.5,0.5)
        main.BackgroundColor3 = _theme.Background; main.BackgroundTransparency = _theme.Transparency
        main.BorderSizePixel = 0; main.ClipsDescendants = true
        Instance.new("UICorner", main).CornerRadius = UDim.new(0, 10)
        local stk = Instance.new("UIStroke", main); stk.Color = _theme.Accent; stk.Thickness = _theme.Stroke

        -- Title
        local title = Instance.new("TextLabel", main)
        title.Size = UDim2.new(1,0,0,55); title.BackgroundTransparency = 1
        title.Text = "Raycast | v3"; title.TextColor3 = _theme.Text
        title.Font = Enum.Font.GothamBold; title.TextSize = 22; title.TextWrapped = true

        -- Subtitle
        local sub = Instance.new("TextLabel", main)
        sub.Size = UDim2.new(1,-20,0,20); sub.Position = UDim2.fromOffset(10,52)
        sub.BackgroundTransparency = 1; sub.Text = "Silent Aim  ·  ESP  ·  Aimbot  ·  Triggerbot"
        sub.TextColor3 = _theme.Accent; sub.Font = Enum.Font.Gotham; sub.TextSize = 11; sub.TextWrapped = true

        -- Key input
        local box = Instance.new("TextBox", main)
        box.Size = UDim2.new(0.85,0,0,40); box.Position = UDim2.fromScale(0.5,0.45)
        box.AnchorPoint = Vector2.new(0.5,0.5); box.BackgroundColor3 = _theme.Secondary
        box.Text = ""; box.PlaceholderText = "Enter Activation Key..."
        box.TextColor3 = _theme.Text; box.Font = Enum.Font.Gotham; box.TextSize = 13
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
        -- Key input focus-glow stroke
        local boxStroke = Instance.new("UIStroke", box)
        boxStroke.Color = _theme.Accent; boxStroke.Thickness = 1; boxStroke.Transparency = 0.75
        box.Focused:Connect(function()
            _ksSound(116271631941040, 0.18, 1.0)
            _tween(boxStroke, 0.18, {Thickness = 2, Transparency = 0})
        end)
        box.FocusLost:Connect(function()
            _tween(boxStroke, 0.25, {Thickness = 1, Transparency = 0.75})
        end)

        -- Feedback label
        local feedback = Instance.new("TextLabel", main)
        feedback.Size = UDim2.new(0.85,0,0,18); feedback.Position = UDim2.fromScale(0.5,0.57)
        feedback.AnchorPoint = Vector2.new(0.5,0.5); feedback.BackgroundTransparency = 1
        feedback.Text = ""; feedback.TextColor3 = Color3.fromRGB(220,80,80)
        feedback.Font = Enum.Font.GothamMedium; feedback.TextSize = 11

        -- Authenticate button
        local loginBtn = Instance.new("TextButton", main)
        loginBtn.Size = UDim2.new(0.85,0,0,40); loginBtn.Position = UDim2.fromScale(0.5,0.68)
        loginBtn.AnchorPoint = Vector2.new(0.5,0.5); loginBtn.BackgroundColor3 = _theme.Accent
        loginBtn.Text = "AUTHENTICATE"; loginBtn.TextColor3 = _theme.Background
        loginBtn.Font = Enum.Font.GothamBold; loginBtn.TextSize = 14
        Instance.new("UICorner", loginBtn).CornerRadius = UDim.new(0, 6)

        -- Get key button
        local getKeyBtn = Instance.new("TextButton", main)
        getKeyBtn.Size = UDim2.new(0.85,0,0,34); getKeyBtn.Position = UDim2.fromScale(0.5,0.86)
        getKeyBtn.AnchorPoint = Vector2.new(0.5,0.5); getKeyBtn.BackgroundColor3 = _theme.Secondary
        getKeyBtn.Text = "GET KEY — DISCORD"; getKeyBtn.TextColor3 = _theme.Text
        getKeyBtn.Font = Enum.Font.GothamMedium; getKeyBtn.TextSize = 12
        Instance.new("UICorner", getKeyBtn).CornerRadius = UDim.new(0, 6)

        _applyAnim(main, false)

        -- ── Button hover animations ──────────────────────────────────────────
        loginBtn.MouseEnter:Connect(function()
            _ksSound(116271631941040, 0.18, 1.12)
            _tween(loginBtn, 0.12, {
                BackgroundColor3 = Color3.new(1, 1, 1),
                Size = UDim2.new(0.87, 0, 0, 42),
            })
        end)
        loginBtn.MouseLeave:Connect(function()
            _tween(loginBtn, 0.2, {
                BackgroundColor3 = _theme.Accent,
                Size = UDim2.new(0.85, 0, 0, 40),
            })
        end)
        getKeyBtn.MouseEnter:Connect(function()
            _ksSound(116271631941040, 0.12, 0.94)
            _tween(getKeyBtn, 0.12, {
                BackgroundColor3 = Color3.fromRGB(35, 35, 44),
                Size = UDim2.new(0.87, 0, 0, 36),
            })
        end)
        getKeyBtn.MouseLeave:Connect(function()
            _tween(getKeyBtn, 0.2, {
                BackgroundColor3 = _theme.Secondary,
                Size = UDim2.new(0.85, 0, 0, 34),
            })
        end)

        -- ── Click handlers ───────────────────────────────────────────────────
        getKeyBtn.MouseButton1Click:Connect(function()
            _ksSound(17779566040, 0.4, 0.95)
            if setclipboard then
                setclipboard(_KEY_CONFIG.Discord)
                getKeyBtn.Text = "DISCORD LINK COPIED ✓"
                task.wait(2); getKeyBtn.Text = "GET KEY — DISCORD"
            else
                getKeyBtn.Text = "discord.gg/h95Xvas2GJ"
            end
        end)

        loginBtn.MouseButton1Click:Connect(function()
            if _fnv1a(box.Text) == _KEY_HASH then
                -- Success: clear attempt counter so re-execution starts fresh
                getgenv()._RCv3_AuthAttempts = nil
                -- Success: green pulse + scale bounce
                _ksSound(138800001279918, 0.55, 1.06)
                loginBtn.Text = "ACCESS GRANTED  ✓"
                _tween(loginBtn, 0.12, {BackgroundColor3 = Color3.fromRGB(30, 220, 100), Size = UDim2.new(0.88, 0, 0, 44)})
                _tween(stk, 0.15, {Color = Color3.fromRGB(30, 220, 100)})
                feedback.Text = ""; feedback.TextColor3 = Color3.fromRGB(30, 220, 100)
                feedback.Text = "Welcome back."
                task.wait(0.15)
                _tween(loginBtn, 0.2, {Size = UDim2.new(0.85, 0, 0, 40)})
                task.wait(0.45)
                _applyAnim(main, true)
                task.wait(0.6)
                sg:Destroy()
                _showLoading(successCb)
            else
                -- Failure: shake main panel + red flash
                _ksSound(17779566040, 0.5, 0.6)
                local attempts = (getgenv()._RCv3_AuthAttempts or 0) + 1
                getgenv()._RCv3_AuthAttempts = attempts
                box.Text = ""
                if attempts >= 5 then
                    feedback.Text = "TOO MANY ATTEMPTS — RERUN SCRIPT"
                    loginBtn.Active = false
                    task.wait(3); sg:Destroy()
                else
                    feedback.Text = "INVALID KEY  (" .. (5 - attempts) .. " attempts left)"
                    -- Shake animation on the main panel
                    -- Shake: chain tweens via Completed events — no task.wait loop.
                    pcall(function()
                        local base  = UDim2.fromScale(0.5, 0.5)
                        local steps = {-9, 9, -7, 7, 0}
                        local function doStep(i)
                            if i > #steps then
                                _tween(main, 0.1, {Position = base})
                                return
                            end
                            local tw = _tween(main, 0.045,
                                {Position = UDim2.new(0.5, steps[i], 0.5, 0)})
                            tw.Completed:Connect(function() doStep(i + 1) end)
                        end
                        doStep(1)
                    end)
                    _tween(loginBtn, 0.1, {BackgroundColor3 = Color3.fromRGB(200, 50, 50)})
                    _tween(stk, 0.1, {Color = Color3.fromRGB(200, 50, 50)})
                    task.wait(1.2)
                    _tween(loginBtn, 0.2, {BackgroundColor3 = _theme.Accent})
                    _tween(stk, 0.3, {Color = _theme.Accent})
                end
            end
        end)
    end

    -- ── LAUNCH ──────────────────────────────────────────────────────────────
    -- Forward-declare so the key system can call it after auth passes.
    -- Everything below this do-block is wrapped inside _RaycastMain().
    _showHandshake(function()
        _initAuth(function()
            -- _RaycastMain is defined immediately after this do-block
            task.defer(function() _RaycastMain() end)
        end)
    end)
end -- key-system block

-- ============================================================================
-- MAIN SCRIPT  (runs only after successful key authentication)
-- ============================================================================
_RaycastMain = function()

-- ── Immediate hook teardown ───────────────────────────────────────────────────
-- On re-execute the PREVIOUS run's hookfunction/hookmetamethod hooks are still
-- active.  Every game:GetService() / property access made before the hook-reset
-- block (~line 1225) passes through them.  Restore the originals NOW, before
-- any method call is made.
-- The full teardown + fresh reinstall still happens at its normal place below.
do
    local _prev = getgenv()._bc_r
    if type(_prev) == "table" then
        if _prev[2] then pcall(hookmetamethod, game, "__index",    _prev[2]) end
        if _prev[7] then pcall(hookmetamethod, game, "__namecall", _prev[7]) end
    end
end

-- Executors always inject after game load; no wait needed.

-- ============================================================================
-- SERVICES  (declared once, shared by all modules)
-- ============================================================================
local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace        = game:GetService("Workspace")
local CoreGui          = game:GetService("CoreGui")
local StarterGui       = game:GetService("StarterGui")

local plr    = Players.LocalPlayer
local mouse  = plr:GetMouse()

-- Camera: stable reference; updated safely in CharacterAdded only.
-- Never overwritten every frame — that is what caused the
-- "Instance expected, got string" crash in CameraModule / ControlModule.
local Camera = Workspace.CurrentCamera

-- ============================================================================
-- EXECUTOR GLOBALS → MODULE-LEVEL LOCAL CACHE
-- ============================================================================
-- Every executor-provided global is captured into an upvalue local here.
-- This achieves three protections against game-side AC:
--
--   A. Closures created after this point resolve these via upvalue, NOT via
--      getgenv(). An AC cannot swap them by writing to getgenv().
--
--   B. After all hooks are installed we nil them from getgenv() (see bottom
--      of hook block). A getgenv() / _G enumeration by AC finds nothing.
--
--   C. protect_function (where supported) marks each cached reference as
--      internal so isexecutorclosure() returns false and getgc() scans skip.
-- ============================================================================
local cloneref           = cloneref           or function(...) return ... end
local clonefunction      = clonefunction      or function(...) return ... end
local protect_function   = protect_function   -- nil on unsupported executors
local checkcaller        = (type(checkcaller) == "function") and checkcaller or function() return true end
local hookmetamethod     = hookmetamethod
local hookfunction       = hookfunction
local newcclosure        = newcclosure
local mousemoverel       = mousemoverel
local mouse1press        = mouse1press
local mouse1release      = mouse1release
-- Shield each cached reference from getgc() introspection where possible.
if protect_function then
    pcall(protect_function, cloneref)
    pcall(protect_function, clonefunction)
    pcall(protect_function, checkcaller)
    pcall(protect_function, hookmetamethod)
    pcall(protect_function, hookfunction)
    pcall(protect_function, newcclosure)
    -- Native C functions (mousemoverel etc.) are no-ops on most executors, harmless.
end

local LP_ref   = cloneref(plr)
local FFC_ref  = (function()
    local ok, f = pcall(clonefunction, game.FindFirstChild)
    return (ok and type(f) == "function") and f or game.FindFirstChild
end)()

-- ============================================================================
-- PRE-CACHED DOT-NOTATION METHODS
-- Must be cached BEFORE any __namecall hook is installed.
-- Using colon-syntax inside a hook overwrites getnamecallmethod().
-- ============================================================================
local GetPlayers              = Players.GetPlayers          -- dot-notation
local FindFirstChild          = game.FindFirstChild          -- dot-notation
local GetPartsObscuringTarget = Camera.GetPartsObscuringTarget -- dot-notation, never goes through __namecall

-- ============================================================================
-- UNIVERSAL HTTP FETCH  (multi-executor support)
-- ============================================================================
local function _httpFetch(url)
    local _hs = game:GetService("HttpService")
    local methods = {
        function() return game:HttpGet(url) end,
        function()
            local req = (syn and syn.request) or (http and http.request) or (getgenv and getgenv().request) or http_request or request
            if req then local r = req({ Url = url, Method = "GET" }); return r.Body or r.body end
        end,
        function() return readurl(url) end,
    }
    for _, fn in ipairs(methods) do
        local ok, result = pcall(fn)
        if ok and result and type(result) == "string" and #result > 0 then return result end
    end
    return nil
end

local function _safeLoad(url)
    local src = _httpFetch(url)
    if not src then return nil end
    local fn, err = loadstring(src)
    if not fn then warn("[Raycast] loadstring failed:", err); return nil end
    local ok, result = pcall(fn)
    if not ok then warn("[Raycast] module error:", result); return nil end
    return result
end

