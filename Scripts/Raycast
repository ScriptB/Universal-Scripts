local AW_conn    = nil

local function AW_stop()
    if AW_conn then AW_conn:Disconnect(); AW_conn = nil end
    if AW_part then pcall(function() AW_part:Destroy() end); AW_part = nil end
end

local function AW_start()
    AW_stop()
    local char = plr.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    AW_part = Instance.new("Part")
