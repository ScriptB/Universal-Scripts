}

-- ============================================================================
-- UTILITY HELPERS
-- ============================================================================
local function getChar(p)  return p.Character end
local function getHRP(p)   local c = getChar(p) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(p)   local c = getChar(p) return c and c:FindFirstChildOfClass("Humanoid") end

local function getActualTargetPart()
    if cfg.SA_TargetPart == "Random" then
        return ValidTargetParts[math.random(1, #ValidTargetParts)]
    end
    return cfg.SA_TargetPart
end

-- ============================================================================
-- TEAM CHECK  ─  universal multi-layer, per-frame cached, real-time reactive.
--
-- Priority  Method                           Reliability
-- ────────  ───────────────────────────────  ───────────
--   1       player.Team instance             Authoritative — built-in Teams service
--   2       player.Neutral flag              Authoritative — lobby / no-team signal
--   3       TeamColor → Team object lookup   Authoritative — validated against Teams
--   4       Player Attributes               Heuristic     — custom attribute systems
--   5       leaderstats Values              Heuristic     — custom leaderboard data
--   6       FFA operational fallback        Fallback      — no data → treat as enemy
--
-- Returns true  = teammate → hide from ESP, skip targeting.
-- Returns false = enemy    → show on ESP, allow targeting.
--
-- Per-frame cache: TC_flushCache() is called once at the top of each
-- RenderStepped tick. All subsystems (ESP, aimbot, triggerbot, GV) that call
-- TC_isTeammate() this frame pay the full resolver cost only on the FIRST call
-- per player — every subsequent call in the same frame is O(1) table lookup.
-- Reactive: Team + Neutral property signals invalidate stale entries instantly.
-- ============================================================================

-- Candidate key names checked in heuristic Layers 4 and 5.
-- Covers the most common custom team/faction/role naming conventions.
local _TC_TEAM_KEYS = {
    "Team", "Faction", "Role", "Side",
    "Alliance", "Group", "Clan", "Guild", "Teams", "Squad", "Squads", "Tribe", "Tribes", "League", "Division", "Set", "Party",
}

-- Per-frame result cache: [Player] = bool  (true = teammate)
local _TC_cache = {}

-- Teams service reference — FindService (not GetService) so we don't create
-- the service in games that genuinely have no teams.
local _TC_TeamsService = game:FindService("Teams")

local function _TC_resolve(p)
    local myTeam    = plr.Team
    local theirTeam = p.Team

    -- ── Layer 1: player.Team — authoritative ───────────────────────────────
    -- Uses == (not rawequal): respects __eq metamethod so executor userdata
    -- wrapping of the same Instance is handled correctly.
    if myTeam ~= nil then
        -- I have a Team; they are a teammate only if they share the exact same object.
        -- Covers unassigned opponent (theirTeam==nil → false) automatically.
        return theirTeam ~= nil and myTeam == theirTeam
    end
    -- myTeam is nil below this line.

    -- ── Layer 2: player.Neutral — authoritative ────────────────────────────
    -- Neutral=false AND Team=nil → assignment is mid-replication (transient).
    -- CRITICAL FIX: only apply the conservative "treat as teammate" guard when
    -- the game actually has Team objects configured.  In games that don't use
    -- the Teams service (most shooter / FPS games), plr.Neutral=false is just
    -- a generic "in-game" flag — blindly returning true here made every player
    -- look like a teammate, silently disabling SA and ESP targeting for ALL
    -- methods in any game without an active Teams service.
    if not plr.Neutral then
        if _TC_TeamsService then
            for _, t in ipairs(_TC_TeamsService:GetChildren()) do
                if t:IsA("Team") then
                    return true   -- game uses Teams; Team=nil is mid-replication
                end
            end
        end
        -- No Team objects found → Neutral=false is unrelated to team assignment.
        -- Fall through to heuristic layers so enemies are detected correctly.
    end
    -- plr.Neutral=true → local player is genuinely teamless (FFA / lobby).
    -- If the target has a team but we don't, they are not our teammate.
    if theirTeam ~= nil then return false end

    -- ── Layer 3: TeamColor → Team object — authoritative ──────────────────
    -- Map each player's TeamColor to an actual Team instance in the Teams
    -- service before comparing. Avoids raw BrickColor string comparison which
    -- is ambiguous when games reuse colours or don't use the Teams service.
    if _TC_TeamsService then
        local myResolved, theirResolved
        for _, t in ipairs(_TC_TeamsService:GetChildren()) do
            if t:IsA("Team") then
                if t.TeamColor == plr.TeamColor then myResolved    = t end
                if t.TeamColor == p.TeamColor   then theirResolved = t end
            end
        end
        -- If at least one colour resolves to a real Team, trust the comparison.
        -- Same object → true. Different objects or one nil → false. Both nil
        -- means no live Team matches either colour → fall through to heuristics.
        if myResolved or theirResolved then
            return myResolved == theirResolved
        end
    end

    -- ── Layer 4: Player Attributes — heuristic ────────────────────────────
    -- Modern Roblox games often store team identity as a Player attribute.
    -- Only acts when BOTH players expose the same key; ignores partial data.
    for _, key in ipairs(_TC_TEAM_KEYS) do
        local myAttr    = plr:GetAttribute(key)
        local theirAttr = p:GetAttribute(key)
        if myAttr ~= nil and theirAttr ~= nil then
            return tostring(myAttr) == tostring(theirAttr)
        end
    end

    -- ── Layer 5: leaderstats Values — heuristic ───────────────────────────
    -- leaderstats is Roblox's built-in leaderboard convention; many games also
    -- store team membership here. Skip empty or zero values (unassigned defaults).
    local myLS    = plr:FindFirstChild("leaderstats")
    local theirLS = p:FindFirstChild("leaderstats")
    if myLS and theirLS then
        for _, key in ipairs(_TC_TEAM_KEYS) do
            local mine   = myLS:FindFirstChild(key)
            local theirs = theirLS:FindFirstChild(key)
            if mine and theirs then
                local v1 = tostring(mine.Value)
                local v2 = tostring(theirs.Value)
                if v1 ~= "" and v1 ~= "0" and v2 ~= "" and v2 ~= "0" then
                    return v1 == v2
                end
            end
        end
    end

    -- ── Layer 6: FFA operational fallback ─────────────────────────────────
    -- No authoritative or heuristic team signal found. Treat as enemy for ESP.
    -- This is a behaviour fallback only — it does not assert the game is FFA.
    return false
end

local function TC_isTeammate(p)
    if p == plr then return true end
    local cached = _TC_cache[p]
    if cached ~= nil then return cached end
    local result = _TC_resolve(p)
    _TC_cache[p] = result
    return result
end

-- Called once at the start of each RenderStepped frame to flush stale results.
local function TC_flushCache() table.clear(_TC_cache) end

-- Reactive invalidation — wipe entries the moment properties change so the
-- next frame's resolver always sees current state.
local function _TC_invalidate(p)   _TC_cache[p] = nil    end
local function _TC_invalidateAll() table.clear(_TC_cache) end

pcall(function()
    -- Hook Team + Neutral on each player (both affect layer 1 and 2 decisions).
    local function _TC_hookPlayer(p)
        p:GetPropertyChangedSignal("Team"):Connect(function()    _TC_invalidate(p) end)
        p:GetPropertyChangedSignal("Neutral"):Connect(function() _TC_invalidate(p) end)
    end
    for _, p in ipairs(Players:GetPlayers()) do _TC_hookPlayer(p) end
    Players.PlayerAdded:Connect(_TC_hookPlayer)
    -- Local player's own team change makes the entire cache stale.
    plr:GetPropertyChangedSignal("Team"):Connect(_TC_invalidateAll)
    plr:GetPropertyChangedSignal("Neutral"):Connect(_TC_invalidateAll)
    -- Teams service gaining/losing Team objects invalidates Layer 3 for all.
    if _TC_TeamsService then
        _TC_TeamsService.ChildAdded:Connect(_TC_invalidateAll)
        _TC_TeamsService.ChildRemoved:Connect(_TC_invalidateAll)
    end
end)

local function shouldTarget(target)
    if target == plr then return false end
    if cfg.TeamCheck and TC_isTeammate(target) then return false end
    if cfg.SA_ignoreForcefield then
        local char = getChar(target)
        if char and char:FindFirstChildOfClass("ForceField") then return false end
    end
    return true
end

-- Wall-check using pre-cached dot-notation to avoid re-entering __namecall
local function isPlayerVisible(Player)
    local PC = Player.Character
    local LC = plr.Character
    if not PC or not LC then return false end
    local apt  = getActualTargetPart()
    local root = FindFirstChild(PC, apt) or FindFirstChild(PC, "HumanoidRootPart")
    if not root then return false end
    local obs = #GetPartsObscuringTarget(Camera, {root.Position}, {LC, PC})
    return obs == 0
end

local function calcChance(chance)
    if chance >= 100 then return true end
    if chance <= 0   then return false end
    return math.random(1, 100) <= chance
end

local function isString(v)
    return type(v) == "string"
end

-- ============================================================================
-- SILENT AIM — GET CLOSEST PLAYER
-- Single-pass, no intermediate table allocations.
-- Uses squared distances to avoid sqrt per player.
-- Wall-check deferred until after FOV filter so only in-FOV players
-- pay the expensive GetPartsObscuringTarget cost.
-- ============================================================================
local function SA_GetClosestPlayer()
    if respawnLock or not plr.Character then
        cfg.SA_currentTarget = nil
        return nil
    end

    local cameraPos  = Camera.CFrame.Position
    local maxRange   = cfg.SA_TargetRange or 1000
    local maxRangeSq = maxRange * maxRange
    local is360      = cfg.SA_360Mode
    local getLowest  = (cfg.SA_GetTarget or "Closest") == "Lowest Health"
    local wallcheck  = cfg.SA_Wallcheck
    local tileArea   = cfg.SA_TArea
    local fovR       = cfg.SA_FovRadius
    local fovRSq     = fovR * fovR
    local targetPart = getActualTargetPart()  -- resolve once, not per-player

    -- Raw screen-center scalars (no Vector2 allocation)
    local viewSize = Camera.ViewportSize
    local screenCX = viewSize.X * 0.5
    local screenCY = viewSize.Y * 0.5

    local bestPart   = nil
    local bestMetric = math.huge
    local bestPlayer = nil

    local allPlayers = GetPlayers(Players)
    for i = 1, #allPlayers do
        local Player = allPlayers[i]
        if Player == plr then continue end
        if not shouldTarget(Player) then continue end

        local Char = Player.Character
        if not Char then continue end
        local Hum = FindFirstChild(Char, "Humanoid")
        if not Hum or Hum.Health <= 0 then continue end

        -- Fast world-distance cull using squared magnitude (no sqrt)
        local root = FindFirstChild(Char, "HumanoidRootPart") or FindFirstChild(Char, "Head")
        if not root then continue end
        local rp = root.Position
        local wdx = cameraPos.X - rp.X
        local wdy = cameraPos.Y - rp.Y
        local wdz = cameraPos.Z - rp.Z
        local worldDistSq = wdx*wdx + wdy*wdy + wdz*wdz
        if worldDistSq > maxRangeSq then continue end

        local metric
        if is360 then
            -- 360 mode: use world distance (or health)
            if wallcheck and not isPlayerVisible(Player) then continue end
            metric = getLowest and Hum.Health or math.sqrt(worldDistSq)
        else
            -- FOV mode: screen-project and check FOV radius
            local _sp3, onScreen = Camera:WorldToViewportPoint(rp)
            if not onScreen then continue end
            local sPos = Vector2.new(_sp3.X, _sp3.Y)
            -- Raw screen-delta arithmetic (no Vector2 allocation)
            local sdx = screenCX - sPos.X
            local sdy = screenCY - (sPos.Y + tileArea)
            local fovDistSq = sdx*sdx + sdy*sdy
            if fovDistSq > fovRSq then continue end
            -- Wall-check only for players already inside FOV
            if wallcheck and not isPlayerVisible(Player) then continue end
            metric = getLowest and Hum.Health or fovDistSq
        end

        if metric < bestMetric then
            bestMetric = metric
            bestPlayer = Player
            -- Resolve actual target part only for the current best
            bestPart = FindFirstChild(Char, targetPart)
                    or FindFirstChild(Char, "Head")
                    or FindFirstChild(Char, "HumanoidRootPart")
                    or root
        end
    end

    cfg.SA_currentTarget = bestPlayer
    return bestPart
end

-- ============================================================================
-- PER-FRAME TARGET PRE-COMPUTATION
-- Instead of computing the SA target inside __namecall / __index hooks
-- (which adds deep nested C-stack frames on top of the game's own call
-- chain and causes "C stack overflow" in camera-Popper / weapon-shoot
-- code), we resolve the target ONCE per render frame in RenderStepped
-- — completely outside any game code stack.  The hooks just read the
-- pre-computed value with zero function call overhead.
-- ============================================================================
local SA_FrameTarget     = nil                  -- BasePart or nil, refreshed each frame
local SA_FrameTargetChar = nil                  -- hitPart.Parent Model, pre-computed
local SA_FrameTargetPos  = Vector3.new(0, 0, 0) -- hitPart.Position, pre-computed (no __index in hook)
local SA_FrameCamPos     = Vector3.new(0, 0, 0) -- Camera.CFrame.Position, pre-computed

local function SA_ResetTargetCache()
    SA_FrameTarget       = nil
    SA_FrameTargetChar   = nil
    cfg.SA_currentTarget = nil
    cfg.SA_FovIsTargeted = false
end

-- Re-entrancy guard: set true while SA_GetClosestPlayer() is executing
-- (during RenderStepped pre-computation) so any nested Workspace:Raycast
-- or mouse-property reads bypass the hook.
local _SA_inHook = false

-- ============================================================================
-- CAMERA-PHASE BYPASS FLAG
-- Roblox's camera system (Popper, ZoomController, Poppercam) runs at
-- RenderPriority.Camera (200).  The Popper's queryPoint calls
-- workspace:Raycast dozens of times per frame from a deep C stack.
-- Even 3-4 extra C frames from our __namecall hook cause overflow.
--
-- FIX: Use BindToRenderStep to bracket the camera phase with a simple
-- boolean.  Callbacks at priority 199 (pre-camera) and 201 (post-camera)
-- set/clear the flag.  Inside the hook, a single boolean check bypasses
-- ALL SA logic for camera-phase raycasts — zero C function calls added
-- beyond the irreducible hookfunction passthrough call.
-- ============================================================================
local _SA_CameraPhase = false
RunService:BindToRenderStep("_SA_preCam",
    Enum.RenderPriority.Camera.Value - 1,
    function() _SA_CameraPhase = true end
)
RunService:BindToRenderStep("_SA_postCam",
    Enum.RenderPriority.Camera.Value + 1,
    function() _SA_CameraPhase = false end
)

-- Target pre-computation — Runs at default RenderStepped priority (0),
-- well before the camera phase (200) and any weapon fire callbacks.
RunService.RenderStepped:Connect(function()
    -- Pre-compute SA target + position + camera every frame.
    -- Runs outside any game call stack so __index overhead is harmless here.
    if cfg.SA_Enabled and not respawnLock then
        _SA_inHook = true
        local part = SA_GetClosestPlayer()
        _SA_inHook = false
        local char = part and part.Parent
        if part and not char then part = nil; char = nil end
        SA_FrameTarget     = part
        SA_FrameTargetChar = char
        SA_FrameTargetPos  = part and part.Position or Vector3.new(0, 0, 0)
        SA_FrameCamPos     = Camera.CFrame.Position
        cfg.SA_FovIsTargeted = (part ~= nil)
    else
        SA_FrameTarget       = nil
        SA_FrameTargetChar   = nil
        SA_FrameTargetPos    = Vector3.new(0, 0, 0)
        SA_FrameCamPos       = Vector3.new(0, 0, 0)
        cfg.SA_currentTarget = nil
        cfg.SA_FovIsTargeted = false
    end
end)


-- ============================================================================
-- HOOK RESET  (prevents double-hooking on re-execute)
-- ============================================================================
-- Hook originals stored under hidden key _bc_r to minimise getgenv() surface.
--   _bc_r[2] = original __index
--   _bc_r[3] = true when Anti-Kick hookfunction is already installed
--   _bc_r[7] = original __namecall
local _bc_r = getgenv()._bc_r or {}
if _bc_r[2] then pcall(hookmetamethod, game, "__index",    _bc_r[2]) end
if _bc_r[7] then pcall(hookmetamethod, game, "__namecall", _bc_r[7]) end
_bc_r[2], _bc_r[3], _bc_r[7] = nil, nil, nil
getgenv()._bc_r = _bc_r

-- Forward declaration (populated by the __namecall hook below)
local OldNamecall             -- game __namecall (intercepts all colon-syntax calls)

-- ============================================================================
-- __INDEX HOOK  (Silent Aim — Mouse.Hit / Mouse.Target / Mouse.UnitRay)
-- ============================================================================
-- __index hook applies the same 3-layer closure-hiding as hookfunction SA:
--   Layer 1: newcclosure  — islclosure()=false, debug.getinfo() shows [C]
--   Layer 2: protect_function — isexecutorclosure()=false, invisible to getgc()
--   Layer 3: clonefunction   — removes executor-ownership flag on identity checks
local OldIndex
do
    local _idxRaw = function(self, index)
        -- Gate: only intercept mouse property reads when SA is active.
        -- self == mouse is checked FIRST (pure Lua compare, zero C calls).
        -- checkcaller() REMOVED — saves 1 C frame per mouse read.
        -- Not needed because: (a) our own code uses OldIndex() directly,
        -- (b) _SA_inHook blocks during target resolution, (c) camera
        -- phase is blocked by _SA_CameraPhase.  Any other executor
        -- mouse read getting redirected is harmless.
        -- Allow Mouse.Hit redirection when method is "Mouse.Hit" OR "All"
        if self ~= mouse
           or _SA_CameraPhase or respawnLock or _SA_inHook
           or not cfg.SA_Enabled
           or (cfg.SA_Method ~= "Mouse.Hit" and cfg.SA_Method ~= "All") then
            return OldIndex(self, index)
        end

        -- Read pre-computed target (resolved per-frame in RenderStepped)
        local hp = SA_FrameTarget
        -- Use OldIndex for ALL Instance property reads on the target
        -- to bypass our own __index hook — prevents recursive re-entry
        -- that was adding 2+ C frames per property and causing overflow
        -- in weapons with deep call stacks (Luger.Ranged → SharedHelper).
        if hp and OldIndex(hp, "Parent") then
            if index == "Target" or index == "target" then
                cfg.SA_FovIsTargeted = true
                return hp
            elseif index == "Hit" or index == "hit" then
                cfg.SA_FovIsTargeted = true
                return OldIndex(hp, "CFrame")
            elseif index == "UnitRay" then
                cfg.SA_FovIsTargeted = true
                local orig = OldIndex(mouse, "Origin")   -- CFrame
                local hpPos = OldIndex(hp, "Position")
                return Ray.new(orig.Position, (hpPos - orig.Position).Unit)
            end
        else
            cfg.SA_FovIsTargeted = false
        end

        return OldIndex(self, index)
    end
    local ok_cc2, _idxCc = pcall(newcclosure, _idxRaw)
    if not ok_cc2 then _idxCc = _idxRaw end
    if protect_function then
        pcall(protect_function, _idxCc)
        pcall(protect_function, _idxRaw)
    end
    local _idxCloneOk = type(clonefunction) == "function" and pcall(clonefunction, _idxCc)
    local _idxFinal = _idxCloneOk and clonefunction(_idxCc) or _idxCc
    local ok_hmm, _hmm_result = pcall(hookmetamethod, game, "__index", _idxFinal)
    if ok_hmm then
        OldIndex = _hmm_result
    else
        warn("[Raycast] hookmetamethod __index failed:", tostring(_hmm_result))
        OldIndex = function(self, index) return rawget(self, index) end
    end
end
_bc_r[2] = OldIndex

-- ============================================================================
-- __NAMECALL HOOK  (Silent Aim — Gravel.cc logic, ported to Raycast v3)
-- ============================================================================
-- Intercepts ALL colon-syntax workspace ray calls.  Redirect logic is copied
-- directly from Gravel.cc's __namecall hook:
--   • "All" mode  → redirect any supported method to the target position.
--   • Specific mode → redirect only the matching method.
--   • Wallbang (Raycast) → return a fake hit result table.
--
-- Raycast v3 additions over Gravel:
--   • SA_FrameTarget pre-computed in RenderStepped → no GetClosestPlayer()
--     call inside the hook (avoids re-entering the game call stack).
--   • SA_FrameTargetPos / SA_FrameCamPos pre-computed → zero __index calls
--     in the redirect path, preventing C stack overflow on deep weapon chains.
--   • Plain Lua function (not newcclosure) → 0 extra C frames on passthrough.
--   • _SA_CameraPhase bypass → camera popper never touches the hook.
-- ============================================================================
do
    local _ncRaw = function(...)
        local self = (select(1, ...))
        -- (1) Fast-exit for non-Workspace — pure Lua comparison, zero C overhead.
        if self ~= Workspace then return OldNamecall(...) end
        -- (2) Cheap Lua flag checks before any C function is touched.
        if _SA_CameraPhase or not cfg.SA_Enabled or respawnLock then return OldNamecall(...) end
        -- (3) Pre-computed target check — pure Lua reads, zero C overhead.
        --     Every render-frame workspace call (e.g. PhysicsHelper.checkEnvironment)
        --     exits here with zero C overhead when no target is in FOV.
        local HitPart = SA_FrameTarget
        local char    = SA_FrameTargetChar
        if not HitPart or not char then
            cfg.SA_FovIsTargeted = false
            return OldNamecall(...)
        end
        -- (4) C functions — only reached when a real target exists.
        if checkcaller() then return OldNamecall(...) end
        local Method = getnamecallmethod()
        if not calcChance(cfg.SA_HitChance) then
            cfg.SA_FovIsTargeted = false
            return OldNamecall(...)
        end
        cfg.SA_FovIsTargeted = true
        local Arguments = {...}
        local tPos = SA_FrameTargetPos   -- pre-computed HitPart.Position, no __index

        -- ── Wallbang (Raycast only) ──────────────────────────────────────────
        -- Return a fake RaycastResult table so the bullet always registers on
        -- the target regardless of geometry.  Gravel's wallbang for legacy methods
        -- only sets local vars without returning, so we match that (no-op for them).
        if cfg.SA_Wallbang and Method == "Raycast" then
            local origin = Arguments[2]
            if typeof(origin) == "Vector3" then
                return {
                    Instance = HitPart,
                    Position = tPos,
                    Normal   = (tPos - origin).Magnitude > 0 and (tPos - origin).Unit or Vector3.new(0, 1, 0),
                    Material = Enum.Material.SmoothPlastic,
                }
            end
        end

        -- ── "All" mode (Gravel.cc lines 1175-1187) ──────────────────────────
        -- Redirect every supported ray method to aim at the target.
        -- No camera proximity check here — _SA_CameraPhase already brackets
        -- the camera system's render step so camera calls never reach this point.
        if cfg.SA_Method == "All" then
            if Method == "FindPartOnRayWithIgnoreList" or Method == "FindPartOnRayWithWhitelist"
               or Method == "FindPartOnRay"             or Method == "findPartOnRay"
               or Method == "Raycast" then
                if Method == "Raycast" then
                    local origin = Arguments[2]
                    if typeof(origin) ~= "Vector3" then return OldNamecall(...) end
                    Arguments[3] = (tPos - origin).Unit * 5000
                else
                    local ray = Arguments[2]
                    if not ray or typeof(ray) ~= "Ray" then return OldNamecall(...) end
                    local origin = ray.Origin
                    Arguments[2] = Ray.new(origin, (tPos - origin).Unit * 5000)
                end
                return OldNamecall(unpack(Arguments))
            end
        end

        -- ── Specific method modes (Gravel.cc lines 1189-1219) ───────────────
        if Method == "FindPartOnRayWithIgnoreList" and cfg.SA_Method == "FindPartOnRayWithIgnoreList" then
            local ray = Arguments[2]
            if not ray or typeof(ray) ~= "Ray" then return OldNamecall(...) end
            local origin = ray.Origin
            Arguments[2] = Ray.new(origin, (tPos - origin).Unit * 5000)
            return OldNamecall(unpack(Arguments))
        elseif Method == "FindPartOnRayWithWhitelist" and cfg.SA_Method == "FindPartOnRayWithWhitelist" then
            local ray = Arguments[2]
            if not ray or typeof(ray) ~= "Ray" then return OldNamecall(...) end
            local origin = ray.Origin
            Arguments[2] = Ray.new(origin, (tPos - origin).Unit * 5000)
            return OldNamecall(unpack(Arguments))
        elseif (Method == "FindPartOnRay" or Method == "findPartOnRay") and cfg.SA_Method == "FindPartOnRay" then
            local ray = Arguments[2]
            if not ray or typeof(ray) ~= "Ray" then return OldNamecall(...) end
            local origin = ray.Origin
            Arguments[2] = Ray.new(origin, (tPos - origin).Unit * 5000)
            return OldNamecall(unpack(Arguments))
        elseif Method == "Raycast" and cfg.SA_Method == "Raycast" then
            local origin = Arguments[2]
            if typeof(origin) ~= "Vector3" then return OldNamecall(...) end
            Arguments[3] = (tPos - origin).Unit * 5000
            return OldNamecall(unpack(Arguments))
        end

        return OldNamecall(...)
    end

    -- Velocity (and most executors) require hookmetamethod hooks to be C closures.
    -- A plain Lua function is silently accepted but never fires — the executor's
    -- internal dispatch only calls C functions as metamethod hooks.
    -- newcclosure overhead (+1 C frame per passthrough) is safe here because our
    -- hook exits before ANY C function call for non-Workspace calls and for
    -- no-target frames (the hot checkEnvironment render path), so the extra frame
    -- only matters on actual redirect attempts — same cost as Gravel's hook.
    local _ncFinal = _ncRaw
    local ok_cc, _ncCc = pcall(newcclosure, _ncRaw)
    if ok_cc then _ncFinal = _ncCc end
    if type(protect_function) == "function" then
        pcall(protect_function, _ncFinal)
        pcall(protect_function, _ncRaw)
    end
    local ok_nc, _nc_result = pcall(hookmetamethod, game, "__namecall", _ncFinal)
    if ok_nc then
        OldNamecall = _nc_result
        _bc_r[7] = OldNamecall
    else
        warn("[Raycast] __namecall hook failed:", tostring(_nc_result))
    end
end

-- ============================================================================
-- ANTI-KICK — hookfunction layer
-- ============================================================================
if not _bc_r[3] then
    _bc_r[3] = true
    pcall(function()
        -- Same 3-layer closure hardening applied to the Anti-Kick hook.
        -- OldKick declared before _kickRaw so the closure captures it as an upvalue.
        local OldKick
        local _kickRaw = function(self, msg)
            if cfg.AK_Enabled and rawequal(self, LP_ref) and isString(msg) then
                if cfg.AK_Notifications then
                    pcall(function()
                        StarterGui:SetCore("SendNotification", {
                            Title = "Raycast | v3 Anti-Kick",
                            Text  = "Kick blocked.",
                            Icon  = "rbxassetid://4483362458",
                            Duration = 4
                        })
                    end)
                end
                return
            end
            return OldKick(self, msg)
        end
        local _kickCc = newcclosure(_kickRaw)
        if protect_function then
            pcall(protect_function, _kickCc)
            pcall(protect_function, _kickRaw)
        end
        local _kickFinal = (type(clonefunction) == "function" and pcall(clonefunction, _kickCc))
                           and clonefunction(_kickCc) or _kickCc
        OldKick = hookfunction(LP_ref.Kick, _kickFinal)
    end)
end

-- ============================================================================
-- ACTIVE AC EVASION
-- ============================================================================
-- Passive protection (newcclosure / protect_function / clonefunction) hides
-- our closures from getgc() scans on supported executors. Active evasion adds
-- three more layers that work even when passive protection is unavailable and
-- defeat detection methods that operate entirely outside of getgc():
--
--   1. getrawmetatable spoof  — game scripts reading game's metamethods see the
--      pre-hook originals, proving to them that __namecall/__index are stock.
--      (rawget on the proxy returns nil for those keys, defeating rawget scans.)
--
--   2. getgc() filter         — our closures are scrubbed from the returned
--      table before it reaches the caller, belt-and-suspenders over protect_fn.
--
--   3. debug.getupvalue block — if a game script obtains any reference to one
--      of our functions through an unguarded path, upvalue inspection returns
--      nil, so Instance upvalues (Workspace, mouse) are never exposed.
--
-- Every evasion hook uses checkcaller() so executor-origin calls always receive
-- real, unfiltered results — nothing executor-internal breaks.
-- ============================================================================

-- Weak-keyed registry: everything registered here is actively scrubbed from
-- getgc() output and blocked from debug.getupvalue inspection.
-- Weak keys allow the GC to still collect these functions normally.
local _BC_HIDDEN = setmetatable({}, {__mode = "k"})
local function _BC_hide(fn)
    if type(fn) == "function" then
        _BC_HIDDEN[fn] = true
        if protect_function then pcall(protect_function, fn) end
    end
end

-- Register every hook-related closure created so far.
_BC_hide(OldNamecall)
_BC_hide(OldIndex)

-- Helper: apply the full 3-layer hardening to an evasion hook closure and
-- register it as hidden before returning the installable final form.
local function _BC_hardenEvasion(fn)
    local ok_ecc, _cc = pcall(newcclosure, fn)
    if not ok_ecc then _cc = fn end
    if protect_function then
        pcall(protect_function, fn)
        pcall(protect_function, _cc)
    end
    local _eCloneOk = type(clonefunction) == "function" and pcall(clonefunction, _cc)
    local _final = _eCloneOk and clonefunction(_cc) or _cc
    _BC_hide(fn); _BC_hide(_cc); _BC_hide(_final)
    return _final
end

-- ── 1. getrawmetatable spoof ────────────────────────────────────────────────
-- When a game script calls getrawmetatable(game) it receives _fakeMt, a proxy
-- table that returns OldIndex for __index and OldNamecall for __namecall and
-- forwards everything else to the real metatable transparently.
-- • rawget(_fakeMt, "__index")    → nil  (no raw entry in the proxy table)
-- • rawget(_fakeMt, "__namecall") → nil  (no raw entry in the proxy table)
-- • _fakeMt.__index               → OldIndex    (via __index metamethod)
-- • _fakeMt.__namecall            → OldNamecall (via __index metamethod)
-- Both raw and cooked reads appear clean. Executor calls get the real mt.
pcall(function()
    if type(getrawmetatable) ~= "function" then return end
    local _realGRM    = getrawmetatable
    local _realGameMt = _realGRM(game)

    local _fakeMt = setmetatable({}, {
        __index = function(_, k)
            if k == "__index"    then return OldIndex end
            if k == "__namecall" then return OldNamecall end
            return rawget(_realGameMt, k)
        end,
        -- Forward writes to the real metatable so legitimate property sets work.
        __newindex = function(_, k, v) rawset(_realGameMt, k, v) end,
        __metatable = "The metatable is locked",
    })
    _BC_hide(_fakeMt)

    hookfunction(_realGRM, _BC_hardenEvasion(function(obj)
        if checkcaller() then return _realGRM(obj) end
        if rawequal(obj, game) then return _fakeMt end
        return _realGRM(obj)
    end))
end)

-- ── 2. getgc() filter ───────────────────────────────────────────────────────
-- Scrub every entry registered in _BC_HIDDEN from getgc() results returned
-- to game scripts. This defeats scanners that enumerate all live closures
-- looking for Lua functions whose upvalues contain Roblox Instances.
pcall(function()
    if type(getgc) ~= "function" then return end
    local _realGetgc = getgc
    hookfunction(_realGetgc, _BC_hardenEvasion(function(includeDead)
        -- Executor-origin calls pass through with includeDead capped to false
        -- to prevent "block too big" from dead-object heap scans on Velocity.
        local ok, raw = pcall(_realGetgc, false)
        if not ok or type(raw) ~= "table" then return {} end
        if checkcaller() then return raw end
        local out = {}
        for i = 1, #raw do
            if not _BC_HIDDEN[raw[i]] then
                out[#out + 1] = raw[i]
            end
        end
        return out
    end))
end)

-- ── 3. debug.getupvalue block ───────────────────────────────────────────────
-- If a game script obtains a reference to one of our functions through any
-- unguarded path (e.g. a missed getgc entry), this ensures upvalue inspection
-- returns nil instead of exposing Instance references.
pcall(function()
    if type(debug) ~= "table" then return end
    if type(debug.getupvalue) ~= "function" then return end
    local _realGUV = debug.getupvalue
    hookfunction(_realGUV, _BC_hardenEvasion(function(fn, n)
        if checkcaller() then return _realGUV(fn, n) end
        if _BC_HIDDEN[fn] then return nil end
        return _realGUV(fn, n)
    end))
end)

-- ── 4. debug.getinfo block ──────────────────────────────────────────────────
-- Some ACs call debug.getinfo(fn) on anything they find in getgc() results to
-- check the source field. For our functions newcclosure already returns "[C]",
-- but for SA hook closures (plain Lua functions) this could expose the source.
-- Return a spoofed info table for any hidden function.
pcall(function()
    if type(debug) ~= "table" then return end
    if type(debug.getinfo) ~= "function" then return end
    local _realGI = debug.getinfo
    hookfunction(_realGI, _BC_hardenEvasion(function(fn, what)
        if checkcaller() then return _realGI(fn, what) end
        if type(fn) == "function" and _BC_HIDDEN[fn] then
            -- Return a minimal info block that looks like a plain C function.
            return { what = "C", source = "[C]", short_src = "[C]",
                     currentline = -1, linedefined = -1, lastlinedefined = -1 }
        end
        return _realGI(fn, what)
    end))
end)

-- ============================================================================
-- ADONIS BYPASS
-- ============================================================================
-- Adonis Admin uses a private AC table discovered at runtime. This module:
--   1. Waits for Adonis to fully initialise (configurable delay)
--   2. Scans getgc() for its internal AC table using Adonis-specific key
--      signatures (Detected+RLocked, Kill+Variables+Process)
--   3. Hooks both Detected (must return true) and Kill (silently discard)
--   4. Hooks getrenv().debug.info so Adonis's coroutine stack inspector
--      yields indefinitely when it tries to inspect one of our functions
--   5. Connects to Adonis RemoteEvents and drops kick/ban/execute payloads
--
-- Runs entirely in task.spawn — never blocks script execution.
-- Every hook closure is registered into _BC_HIDDEN and hardened.
-- On non-Adonis games the scan finds nothing and exits cleanly.
-- ============================================================================
do
    local function ADB_notify(msg)
        if not cfg.ADB_Notify then return end
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title    = "Raycast | v3 · Adonis Bypass",
                Text     = msg,
                Duration = 4,
            })
        end)
    end

    task.spawn(function()
        -- Re-check at execution time in case the toggle was flipped after load.
        if not cfg.ADB_Enabled then return end

        -- ── Wait for Adonis init ──────────────────────────────────────────────
        -- Adonis initialises ReplicatedStorage objects after ~5-10 seconds.
        -- We poll for any child whose name contains "adonis" or "admin".
        local waited = 0
        local function adonisReady()
            for _, v in next, game:GetService("ReplicatedStorage"):GetChildren() do
                local n = v.Name:lower()
                if n:find("adonis",1,true) or n:find("admin",1,true) then
                    return true
                end
            end
            return false
        end
        repeat
            task.wait(1)
            waited += 1
        until waited >= cfg.ADB_ScanDelay or adonisReady()
        task.wait(2)  -- allow Adonis coroutines to fully spawn

        -- ── Step 1: Hook Detected + Kill via getgc() ─────────────────────────
        local detectedHooked = false
        local killHooked     = false

        pcall(function()
            if type(getgc) ~= "function" then return end

            for _, v in next, getgc(false) do
                if typeof(v) ~= "table" then continue end

                local Detected  = rawget(v, "Detected")
                local RLocked   = rawget(v, "RLocked")
                local Kill      = rawget(v, "Kill")
                local Variables = rawget(v, "Variables")
                local Process   = rawget(v, "Process")

                -- Primary detection gate: Detected(action, info, crash)
                -- Adonis checks the return — true means "already handled, ignore".
                if not detectedHooked
                   and typeof(Detected) == "function" and RLocked ~= nil then

                    local _orig = Detected
                    pcall(hookfunction, _orig, _BC_hardenEvasion(function(action, info, crash)
                        -- Pass through internal system pings (action=="_")
                        if action == "_" and info == "_" then
                            return _orig(action, info, crash)
                        end
                        return true  -- suppress all real detections
                    end))
                    _BC_hide(Detected)
                    detectedHooked = true
                end

                -- Fallback kill path: called if Detected doesn't suppress.
                if not killHooked
                   and typeof(Kill) == "function"
                   and Variables ~= nil and Process ~= nil then

                    pcall(hookfunction, Kill, _BC_hardenEvasion(function(_)
                        return nil  -- silently discard
                    end))
                    _BC_hide(Kill)
                    killHooked = true
                end

                if detectedHooked and killHooked then break end
            end
        end)

        if detectedHooked or killHooked then
            ADB_notify("AC hooks installed")
        end

        -- ── Step 2: getrenv().debug.info yield trap ───────────────────────────
        -- Adonis walks the call stack using its own copy of debug.info from the
        -- Roblox environment (getrenv). When it inspects a function registered
        -- in _BC_HIDDEN we yield the scanning coroutine indefinitely, preventing
        -- the check from ever completing.
        pcall(function()
            local _savedId
            pcall(function() _savedId = getthreadidentity() end)
            pcall(function() setthreadidentity(2) end)  -- needs elevated identity

            local _ok, renv = pcall(getrenv)
            if _ok and type(renv) == "table"
               and type(renv.debug) == "table"
               and type(renv.debug.info) == "function" then

                local _realDI = renv.debug.info
                pcall(hookfunction, _realDI, _BC_hardenEvasion(function(co_or_fn, ...)
                    if not checkcaller() then
                        -- Determine which function is being inspected.
                        local fn = co_or_fn
                        if type(fn) == "thread" then
                            -- (level, options) form — we can't easily extract the fn;
                            -- let it pass; the Detected hook already blocked the action.
                        elseif type(fn) == "function" and _BC_HIDDEN[fn] then
                            -- Yield the scanning coroutine forever.
                            return coroutine.yield(coroutine.running())
                        end
                    end
                    return _realDI(co_or_fn, ...)
                end))
            end

            pcall(function() setthreadidentity(_savedId or 7) end)
        end)

        -- ── Step 3: RemoteEvent payload interception ──────────────────────────
        -- Adonis fires a MainEvent (or equivalent) to the client with a command
        -- string as the first argument. We listen via OnClientEvent and drop
        -- any payload whose command matches kick/ban/execute/detected.
        if cfg.ADB_BlockRemotes then
            pcall(function()
                local _BLOCKED_CMDS = {
                    kick=true, ban=true, tempban=true, detected=true,
                    execute=true, shutdown=true, adminkick=true,
                }
                local RS = game:GetService("ReplicatedStorage")

                local function tryHookRemote(obj)
                    if not pcall(function() return obj:IsA("RemoteEvent") end) then return end
                    if not obj:IsA("RemoteEvent") then return end
                    local lname = obj.Name:lower()
                    -- Target Adonis's MainEvent or any suspiciously named remote.
                    if lname:find("adonis",1,true) or lname:find("event",1,true)
                       or lname:find("admin",1,true) or lname:find("logger",1,true) then
                        obj.OnClientEvent:Connect(function(cmd)
                            -- If the first arg is a blocked command, silently discard.
                            -- Note: this fires AFTER the event is received; we can't
                            -- truly prevent it, but we can prevent our code from acting
                            -- on it and we block the kick via Anti-Kick hookfunction.
                            local c = tostring(cmd):lower()
                            if _BLOCKED_CMDS[c] then return end
                        end)
                    end
                end

                for _, obj in next, RS:GetDescendants() do
                    pcall(tryHookRemote, obj)
                end
                RS.DescendantAdded:Connect(function(obj)
                    task.wait()  -- allow the object to fully replicate
                    pcall(tryHookRemote, obj)
                end)
            end)
        end
    end)  -- task.spawn
end

-- ============================================================================
-- ESP  (Drawing API)
-- Corner box · filled health bar · head dot · per-component colours
-- All Drawing objects are pre-allocated per player and re-used every frame.
-- ============================================================================
local ESP_CACHE = {}

local function _L(thick, col)   -- Line helper
    local o = Drawing.new("Line")
    o.Thickness = thick or 1.5; o.Color = col or Color3.new(1,1,1)
    o.Visible = false; return o
end
local function _S(filled, thick) -- Square helper
    local o = Drawing.new("Square")
    o.Filled = filled; o.Thickness = thick or 1
    o.Visible = false; return o
end
local function _T(sz)            -- Text helper
    local o = Drawing.new("Text")
    o.Size = sz or 13; o.Center = true; o.Outline = true
    o.Visible = false; return o
end
local function _C(thick)         -- Circle helper
    local o = Drawing.new("Circle")
    o.Thickness = thick or 1.5; o.Filled = false
    o.Visible = false; return o
end

local function ESP_remove(p)
    local d = ESP_CACHE[p]
    if not d then return end
    -- remove all Drawing objects, destroy the Highlight instance
    for _, k in ipairs({"TLH","TLV","TRH","TRV","BLH","BLV","BRH","BRV",
        "Box","BoxShadow","Name","Dist","HealthBG","HealthFill","HeadDot","Tracer"}) do
        pcall(function() d[k]:Remove() end)
    end
    pcall(function() d.Highlight:Destroy() end)
    ESP_CACHE[p] = nil
end

local function ESP_create(p)
    local d = {
        -- Corner box: 8 lines (top-left/right, bottom-left/right × H+V)
        TLH = _L(1.5), TLV = _L(1.5),
        TRH = _L(1.5), TRV = _L(1.5),
        BLH = _L(1.5), BLV = _L(1.5),
        BRH = _L(1.5), BRV = _L(1.5),
        -- Full outline box (unfilled Square) + dark shadow ring for contrast
        Box       = _S(false, 1),
        BoxShadow = _S(false, 3),
        -- Labels
        Name = _T(13),
        Dist = _T(11),
        -- Health bar: background + coloured fill (filled Squares)
        HealthBG   = _S(true, 1),
        HealthFill = _S(true, 1),
        -- Head dot
        HeadDot = _C(1.5),
        -- Tracer line
        Tracer = _L(1),
        -- Chams (Roblox Highlight instance)
        Highlight = Instance.new("Highlight"),
    }
    d.BoxShadow.Color       = Color3.fromRGB(0, 0, 0)
    d.BoxShadow.Transparency = 0.55
    d.HealthBG.Color        = Color3.fromRGB(15, 15, 15)
    d.Dist.Color            = Color3.fromRGB(200, 200, 200)
    d.Highlight.Name        = "BC_ESP_Cham"
    ESP_CACHE[p] = d
    return d
end

-- Pre-allocated key lists — avoids table construction on every frame.
local _CORNER_KEYS = {"TLH","TLV","TRH","TRV","BLH","BLV","BRH","BRV"}
local _ALL_KEYS    = {"TLH","TLV","TRH","TRV","BLH","BLV","BRH","BRV",
    "Box","BoxShadow","Name","Dist","HealthBG","HealthFill","HeadDot","Tracer"}

-- Set all eight corner-line positions and visibility in one call.
local V2 = Vector2.new
local function _drawCorners(d, x, y, w, h, col, vis)
    local cl = math.max(5, math.floor(math.min(w, h) * 0.22))
    local x2, y2 = x + w, y + h
    d.TLH.From = V2(x,  y);   d.TLH.To = V2(x+cl, y)
    d.TLV.From = V2(x,  y);   d.TLV.To = V2(x,    y+cl)
    d.TRH.From = V2(x2, y);   d.TRH.To = V2(x2-cl,y)
    d.TRV.From = V2(x2, y);   d.TRV.To = V2(x2,   y+cl)
    d.BLH.From = V2(x,  y2);  d.BLH.To = V2(x+cl, y2)
    d.BLV.From = V2(x,  y2);  d.BLV.To = V2(x,    y2-cl)
    d.BRH.From = V2(x2, y2);  d.BRH.To = V2(x2-cl,y2)
    d.BRV.From = V2(x2, y2);  d.BRV.To = V2(x2,   y2-cl)
    for _, k in ipairs(_CORNER_KEYS) do
        d[k].Color = col; d[k].Visible = vis
    end
end

-- Hide every Drawing object and detach the Highlight without destroying.
local function _hideESP(d)
    for _, k in ipairs(_ALL_KEYS) do
        d[k].Visible = false
    end
    d.Highlight.Parent = nil
end

RunService.RenderStepped:Connect(function()
    TC_flushCache()   -- flush team-check cache; each player resolved fresh this frame
    local camCF  = Camera.CFrame
    local camPos = camCF.Position
    local vpSize = Camera.ViewportSize
    local snapPt = V2(vpSize.X * 0.5, vpSize.Y)  -- tracer origin: bottom-centre

    for _, p in pairs(Players:GetPlayers()) do
        -- ── master guards ──────────────────────────────────────────────────
        if p == plr or not cfg.ESP_Enabled then ESP_remove(p); continue end
        if cfg.TeamCheck and TC_isTeammate(p) then ESP_remove(p); continue end

        local char = getChar(p)
        local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if not (head and hum and hum.Health > 0) then
            ESP_remove(p); continue
        end

        local dist3D = (head.Position - camPos).Magnitude

        -- ── screen projection ──────────────────────────────────────────────
        local headVP, onScreen = Camera:WorldToViewportPoint(head.Position)
        local d = ESP_CACHE[p] or ESP_create(p)
        if not d then continue end
        if not onScreen then _hideESP(d); continue end

        -- ── bounding box geometry ─────────────────────────────────────────
        -- Top = slightly above Head apex; Bottom = HRP minus hip-height.
        -- Covers R6, R15, and arbitrary custom rigs without hardcoded offsets.
        local hrpPos  = hrp and hrp.Position or head.Position
        local hipH    = hum.HipHeight
        local topVP   = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.75, 0))
        local botVP   = Camera:WorldToViewportPoint(hrpPos        - Vector3.new(0, hipH + 0.1, 0))
        local bTop    = math.min(topVP.Y, botVP.Y)
        local bBot    = math.max(topVP.Y, botVP.Y)
        local bH      = math.max(bBot - bTop, 10)
        local bW      = bH / 1.75
        local bX      = headVP.X - bW * 0.5   -- left edge
        local bY      = bTop                   -- top edge
        local col     = cfg.ESP_Color

        -- ── box (corner or full) ──────────────────────────────────────────
        local showBox    = cfg.ESP_Box
        local isCorner   = cfg.ESP_BoxStyle ~= "Full"
        _drawCorners(d, bX, bY, bW, bH, col, showBox and isCorner)
        d.BoxShadow.Position = V2(bX - 1, bY - 1)
        d.BoxShadow.Size     = V2(bW + 2, bH + 2)
        d.BoxShadow.Visible  = showBox and not isCorner
        d.Box.Position       = V2(bX, bY)
        d.Box.Size           = V2(bW, bH)
        d.Box.Color          = col
        d.Box.Visible        = showBox and not isCorner

        -- ── head dot ──────────────────────────────────────────────────────
        d.HeadDot.Visible = cfg.ESP_HeadDot
        if cfg.ESP_HeadDot then
            d.HeadDot.Position = V2(headVP.X, headVP.Y)
            d.HeadDot.Radius   = math.max(math.floor(bW * 0.13), 3)
            d.HeadDot.Color    = col
        end

        -- ── name (above box) ──────────────────────────────────────────────
        d.Name.Visible = cfg.ESP_Name
        if cfg.ESP_Name then
            -- Show DisplayName if it differs from Name
            d.Name.Text     = p.DisplayName ~= p.Name
                and p.DisplayName .. " [" .. p.Name .. "]"
                or  p.Name
            d.Name.Position = V2(headVP.X, bY - 15)
            d.Name.Color    = col
        end

        -- ── distance (below box, in studs) ────────────────────────────────
        d.Dist.Visible = cfg.ESP_Dist
        if cfg.ESP_Dist then
            d.Dist.Text     = string.format("%d m", math.floor(dist3D))
            d.Dist.Position = V2(headVP.X, bBot + 3)
        end

        -- ── health bar (3 px wide, left of box, grows bottom-up) ──────────
        d.HealthBG.Visible   = cfg.ESP_Health
        d.HealthFill.Visible = cfg.ESP_Health
        if cfg.ESP_Health then
            local frac   = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            local fillH  = math.max(math.floor(bH * frac), 1)
            -- colour: green when full, red when empty
            local hpR    = math.floor((1 - frac) * 255)
            local hpG    = math.floor(frac * 200 + 30)
            local bX2    = bX - 5
            d.HealthBG.Position   = V2(bX2, bY)
            d.HealthBG.Size       = V2(3, bH)
            d.HealthFill.Position = V2(bX2, bY + bH - fillH)
            d.HealthFill.Size     = V2(3, fillH)
            d.HealthFill.Color    = Color3.fromRGB(hpR, hpG, 30)
        end

        -- ── tracer (bottom-centre of screen → enemy feet) ─────────────────
        d.Tracer.Visible = cfg.ESP_Tracer
        if cfg.ESP_Tracer then
            d.Tracer.From  = snapPt
            d.Tracer.To    = V2(headVP.X, bBot)
            d.Tracer.Color = cfg.ESP_TracerColor
        end

        -- ── chams (Highlight, renders through walls) ───────────────────────
        if cfg.ESP_Cham then
            d.Highlight.FillColor           = col
            d.Highlight.OutlineColor        = Color3.fromRGB(0, 0, 0)
            d.Highlight.FillTransparency    = cfg.ESP_ChamFill
            d.Highlight.OutlineTransparency = cfg.ESP_ChamOutline
            d.Highlight.Parent              = char
        else
            d.Highlight.Parent = nil
        end
    end
end)

-- Clean up drawings when a player leaves the server.
Players.PlayerRemoving:Connect(function(p) ESP_remove(p) end)

-- ============================================================================
-- AIMBOT
-- Uses mousemoverel only — never touches CameraType.
-- This is the fix for the camera-stuck bug: no CameraType.Scriptable anywhere.
-- ============================================================================
-- Pre-allocated params — updated per character load rather than per call.
local _AB_Params = RaycastParams.new()
_AB_Params.FilterType = Enum.RaycastFilterType.Exclude

local function AB_isVisible(part, char)
    _AB_Params.FilterDescendantsInstances = {getChar(plr), Camera}
    -- Use actual distance instead of a hardcoded 1000 studs so targets
    -- further away are not incorrectly considered blocked.
    local origin = Camera.CFrame.Position
    local dir    = (part.Position - origin)
    local result = Workspace:Raycast(origin, dir, _AB_Params)
    return not result or result.Instance:IsDescendantOf(char)
end

local function AB_getBestTarget()
    -- Use screen-pixels FOV scaled to current viewport width so it feels
    -- consistent across different resolutions (original was a fixed pixel radius).
    local vpW    = Camera.ViewportSize.X
    local fovPx  = cfg.AB_FOV * (vpW / 1920)  -- normalise to 1080p baseline
    local target, shortestDist = nil, fovPx
    local center = Vector2.new(vpW / 2, Camera.ViewportSize.Y / 2)

    for _, p in pairs(Players:GetPlayers()) do
        if p == plr or not p.Character then continue end
        if cfg.TeamCheck and TC_isTeammate(p) then continue end

        local char = p.Character
        local part = char:FindFirstChild(cfg.AB_TargetPart)
                  or char:FindFirstChild("Head")
                  or char:FindFirstChild("HumanoidRootPart")
        local hum  = char:FindFirstChildOfClass("Humanoid")

        if part and hum and hum.Health > 0 then
            if cfg.AB_VisibleCheck and not AB_isVisible(part, char) then continue end

            local w2s, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local dist = (Vector2.new(w2s.X, w2s.Y) - center).Magnitude
                if dist < shortestDist then
                    target, shortestDist = part, dist
                end
            end
        end
    end
    return target
end

-- VirtualInputManager provides a more reliable mouse-move path than
-- mousemoverel on games that use custom camera controllers (MouseDelta events).
local _VIM = game:GetService("VirtualInputManager")
local function AB_moveMouse(dx, dy)
    local ok = pcall(function()
        _VIM:SendMouseMoveEvent(dx, dy, false)
    end)
    if not ok then
        -- Fallback: direct executor function
        pcall(mousemoverel, dx, dy)
    end
end

RunService.RenderStepped:Connect(function()
    if not cfg.AB_Enabled or respawnLock then return end

    local isAiming = false
    if cfg.AB_Key then
        if typeof(cfg.AB_Key) == "EnumItem" and cfg.AB_Key.EnumType == Enum.UserInputType then
            isAiming = UserInputService:IsMouseButtonPressed(cfg.AB_Key)
        elseif typeof(cfg.AB_Key) == "EnumItem" then
            isAiming = UserInputService:IsKeyDown(cfg.AB_Key)
        end
    end
    if not isAiming then return end

    local target = AB_getBestTarget()
    if not target then return end

    local pos = target.Position
    if cfg.AB_Prediction then
        pos = pos + (target.AssemblyLinearVelocity * cfg.AB_PredictionFactor)
    end

    local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
    if onScreen then
        local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        local delta  = Vector2.new(screenPos.X, screenPos.Y) - center
        local smooth = math.max(cfg.AB_Smoothness, 1)
        local mode   = cfg.AB_AggressionMode

        if mode == "Rage" then
            -- Bypass VIM: direct mousemoverel is the only reliable path for instant snap.
            -- VIM SendMouseMoveEvent clamps/smooths large per-frame values on many builds.
            -- Round to integer — fractional pixel values confuse some executor implementations.
            pcall(mousemoverel, math.floor(delta.X + 0.5), math.floor(delta.Y + 0.5))
        else
            local moveX, moveY
            if mode == "Aggressive" then
                -- Distance-weighted: fast when far, smoother when nearly on target.
                local t = math.min(delta.Magnitude / 100, 1)
                local s = math.max(smooth * (1 - t * 0.8), 1)
                moveX, moveY = delta.X / s, delta.Y / s
            elseif mode == "Ghost" then
                -- Fixed 7% lerp per frame — slow humanized arc, ignores Smoothing slider.
                moveX, moveY = delta.X * 0.07, delta.Y * 0.07
            else
                -- Normal: classic delta / smooth.
                moveX, moveY = delta.X / smooth, delta.Y / smooth
            end
            AB_moveMouse(moveX, moveY)
        end
    end
end)

-- ============================================================================
-- TRIGGERBOT
-- ============================================================================
local TB_lastShot = 0
local TB_firing   = false

local function TB_simulateClick(delaySec)
    TB_firing = true
    if delaySec > 0 then task.wait(delaySec) end
    if mouse1press then mouse1press() end
    task.wait(math.random(12, 28) / 1000)
    if mouse1release then mouse1release() end
    TB_firing = false
end

-- Walk up the instance hierarchy to find a player character.
-- Handles accessories, tools, nested models, and R15/R6 rigs.
local function TB_getPlayerFromHit(instance)
    local obj = instance
    for _ = 1, 6 do
        if not obj or not obj.Parent then break end
        local p = Players:GetPlayerFromCharacter(obj)
        if p then return p, obj end
        obj = obj.Parent
    end
    return nil, nil
end

RunService.RenderStepped:Connect(function()
    if not cfg.TB_Enabled or respawnLock then return end
    if TB_firing then return end
    if tick() - TB_lastShot < cfg.TB_Interval / 1000 then return end
    -- Never fire while the cursor is over any GUI element (menus, AxiUI, etc.)
    if UserInputService:IsMouseOverGui() then return end

    local ray    = Camera:ViewportPointToRay(mouse.X, mouse.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {getChar(plr), Camera}

    local result = Workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
    if not result or not result.Instance then return end

    local p, char = TB_getPlayerFromHit(result.Instance)
    if not p or p == plr then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    if cfg.TeamCheck and TC_isTeammate(p) then return end

    -- Lock out further fires immediately so the delay period can't stack shots.
    TB_lastShot = tick()
    task.spawn(TB_simulateClick, (cfg.TB_Delay or 0) / 1000)
end)

-- ============================================================================
-- ANTI-AIM
-- ============================================================================
local function AA_findClosestEnemy()
    local closest, shortestDist = nil, math.huge
    local hrp = getHRP(plr)
    if not hrp then return end

    for _, p in pairs(Players:GetPlayers()) do
        if p == plr or not p.Character then continue end
        if cfg.TeamCheck and TC_isTeammate(p) then continue end
        local pHRP = getHRP(p)
        local pHum = getHum(p)
        if pHRP and pHum and pHum.Health > 0 then
            local dist = (pHRP.Position - hrp.Position).Magnitude
            if dist < shortestDist then
                closest, shortestDist = pHRP, dist
            end
        end
    end
    return closest
end

-- Camera-lock state for Anti-Aim
-- When AA teleports the HRP the default camera spring chases it, producing
-- the "camera flies off and slowly reconnects" effect. We fix this by switching
-- to Scriptable camera type while AA is active, then restoring Custom on exit.
-- Mouse delta is accumulated each frame so the player can still look around.
local AA_camLocked  = false
local AA_camYaw     = 0
local AA_camPitch   = 0
local AA_camOrigin  = Vector3.zero
local AA_camDist    = 15    -- approximate default follow-distance
local AA_MOUSE_SENS = 0.3   -- degrees per pixel

local function AA_startCamLock()
    if AA_camLocked then return end
    AA_camLocked = true
    local cf     = Camera.CFrame
    AA_camOrigin = cf.Position
    -- Extract current yaw/pitch so the view doesn't snap
    local _, y, _ = cf:ToEulerAnglesYXZ()
    AA_camYaw    = y
    AA_camPitch  = 0
    Camera.CameraType = Enum.CameraType.Scriptable
    -- Run AFTER Roblox's own camera processing so our write wins
    RunService:BindToRenderStep("AA_CamLock", Enum.RenderPriority.Last.Value, function()
        if not AA_camLocked then
            RunService:UnbindFromRenderStep("AA_CamLock")
            return
        end
        local delta = UserInputService:GetMouseDelta()
        AA_camYaw   = AA_camYaw   - math.rad(delta.X * AA_MOUSE_SENS)
        AA_camPitch = math.clamp(
            AA_camPitch - math.rad(delta.Y * AA_MOUSE_SENS),
            math.rad(-80), math.rad(80)
        )
        Camera.CFrame = CFrame.new(AA_camOrigin)
            * CFrame.Angles(0, AA_camYaw,   0)
            * CFrame.Angles(AA_camPitch, 0, 0)
            * CFrame.new(0, 0, AA_camDist)
    end)
end

local function AA_stopCamLock()
    if not AA_camLocked then return end
    AA_camLocked = false
    RunService:UnbindFromRenderStep("AA_CamLock")
    Camera.CameraType = Enum.CameraType.Custom
    local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    if hum then Camera.CameraSubject = hum end
end

local function AA_restorePos()
    AA_stopCamLock()
    if cfg.AA_OriginalPos and plr.Character then
        local hrp = getHRP(plr)
        if hrp then hrp.CFrame = CFrame.new(cfg.AA_OriginalPos) end
        cfg.AA_OriginalPos  = nil
        cfg.AA_IsTeleported = false
    end
end

RunService.Heartbeat:Connect(function()
    if not cfg.AA_Enabled then
        if cfg.AA_IsTeleported then AA_restorePos() end
        return
    end
    if respawnLock then return end

    local target = AA_findClosestEnemy()
    local hrp    = getHRP(plr)

    if target and hrp then
        if not cfg.AA_OriginalPos then
            cfg.AA_OriginalPos = hrp.Position
            -- Lock camera the moment we first teleport so it never chases the HRP
            AA_camOrigin = Camera.CFrame.Position
            do
                local _, y, _ = Camera.CFrame:ToEulerAnglesYXZ()
                AA_camYaw   = y
                AA_camPitch = 0
            end
            AA_startCamLock()
        end
        cfg.AA_IsTeleported = true

        if cfg.AA_Method == "Orbit" then
            local angle  = tick() * cfg.AA_OrbitSpeed
            local offset = Vector3.new(
                math.cos(angle) * cfg.AA_OrbitRadius,
                cfg.AA_OrbitHeight,
                math.sin(angle) * cfg.AA_OrbitRadius
            )
            hrp.CFrame = CFrame.new(target.Position + offset, target.Position)
        elseif cfg.AA_Method == "Above" then
            hrp.CFrame = CFrame.new(target.Position + Vector3.new(0, cfg.AA_AboveHeight, 0))
        elseif cfg.AA_Method == "Behind" then
            hrp.CFrame = CFrame.new(target.Position - target.CFrame.LookVector * cfg.AA_BehindDistance)
        end
    elseif cfg.AA_IsTeleported then
        AA_restorePos()
    end
end)

-- ============================================================================
-- SILENT AIM — FOV CIRCLE
-- ============================================================================
local SA_Gui    = Instance.new("ScreenGui")
local SA_Frame  = Instance.new("Frame")
local SA_Stroke = Instance.new("UIStroke")
local SA_Corner = Instance.new("UICorner")

SA_Gui.Name              = "BC_SA2_FOV"
SA_Gui.Parent            = CoreGui
SA_Gui.IgnoreGuiInset    = true

SA_Frame.Name                  = "FOVCircle"
SA_Frame.Parent                = SA_Gui
SA_Frame.AnchorPoint           = Vector2.new(0.5, 0.5)
SA_Frame.BackgroundTransparency = 1
SA_Frame.BorderSizePixel       = 0
SA_Frame.Visible               = false

SA_Corner.CornerRadius = UDim.new(1, 0)
SA_Corner.Parent       = SA_Frame

SA_Stroke.Thickness    = 1
SA_Stroke.Color        = cfg.SA_FovColor
SA_Stroke.Transparency = 1 - cfg.SA_FovTransparency
SA_Stroke.Parent       = SA_Frame

RunService.RenderStepped:Connect(function()
    local vp = Camera.ViewportSize
    if vp.X == 0 then return end

    if respawnLock or not cfg.SA_Enabled or not cfg.SA_FovVisible or cfg.SA_360Mode then
        SA_Frame.Visible = false
        return
    end

    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    SA_Frame.Visible  = true
    SA_Frame.Position = UDim2.new(0, center.X, 0, center.Y)
    SA_Frame.Size     = UDim2.new(0, cfg.SA_FovRadius * 2, 0, cfg.SA_FovRadius * 2)
    SA_Stroke.Color   = cfg.SA_FovIsTargeted and cfg.SA_FovColorTarget or cfg.SA_FovColor
    SA_Stroke.Transparency = 1 - cfg.SA_FovTransparency
end)

-- ============================================================================
-- VISUALIZER-BC
-- ============================================================================
local VBC_Materials = {
    ForceField    = Enum.Material.ForceField,
    Neon          = Enum.Material.Neon,
    SmoothPlastic = Enum.Material.SmoothPlastic,
    Glass         = Enum.Material.Glass,
}

local VBC_Part = nil

local function VBC_destroy()
    if VBC_Part then
        pcall(function() VBC_Part:Destroy() end)
        VBC_Part = nil
    end
end

local function VBC_getPart()
    if VBC_Part and VBC_Part.Parent then return VBC_Part end
    local part = Instance.new("Part")
    part.Name = "BC_Visualizer"
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.CastShadow = false
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = Workspace
    VBC_Part = part
    return part
end

RunService.RenderStepped:Connect(function()
    if not cfg.VBC_Enabled or respawnLock then
        VBC_destroy()
        return
    end

    local hrp = getHRP(plr)
    if not hrp then
        VBC_destroy()
        return
    end

    local part = VBC_getPart()
    local reach = math.max(1, cfg.VBC_ReachDistance)

    part.Shape = (cfg.VBC_ReachType == "Box") and Enum.PartType.Block or Enum.PartType.Ball
    part.Size = Vector3.new(reach * 2, reach * 2, reach * 2)
    part.CFrame = hrp.CFrame
    part.Material = VBC_Materials[cfg.VBC_Material] or Enum.Material.ForceField
    part.Color = cfg.VBC_Color
    part.Transparency = math.clamp(cfg.VBC_Transparency, 0, 1)
end)

-- ============================================================================
-- CLIENT MODS-BC
-- ============================================================================
local CMBC_LastNoclipUpdate = 0

RunService.Heartbeat:Connect(function()
    if respawnLock or not cfg.CMBC_Enabled then return end

    local char = getChar(plr)
    local hum = getHum(plr)
    if not char or not hum then return end

    hum.WalkSpeed = cfg.CMBC_WalkSpeed
    hum.JumpPower = cfg.CMBC_JumpPower

    if cfg.CMBC_Animations then
        for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
            track:AdjustSpeed(cfg.CMBC_AnimSpeed)
        end
    end

    if cfg.CMBC_Noclip then
        local now = os.clock()
        if (now - CMBC_LastNoclipUpdate) >= 0.08 then
            CMBC_LastNoclipUpdate = now
            for _, inst in ipairs(char:GetDescendants()) do
                if inst:IsA("BasePart") then
                    inst.CanCollide = false
                end
            end
        end
    end
end)

-- ============================================================================
-- math.clamp SAFETY PATCH  (BulletWeapon line 428 fix)
-- BulletWeapon:428 calls math.clamp(v, min, max) where min > max, which errors.
-- We must intercept math.clamp globally so ALL callers (including game scripts
-- that reference it inline rather than caching it as an upvalue) get the fix.
--
-- Strategy (try each in order, stop on first success):
--   1. hookfunction(math.clamp, safe)          — works if executor supports it
--   2. getrenv().math.clamp = safe             — game scripts use getrenv()
--   3. rawset(math, "clamp", safe)             — bypasses __newindex if present
--   4. math.clamp = safe                       — direct write (fails if frozen)
--   5. getgc scan + debug.setupvalue           — last resort for cached upvalues
-- ============================================================================
if not getgenv().__BW_ClampPatched then
    getgenv().__BW_ClampPatched = true
    local _oc = math.clamp
    local _safe = newcclosure(function(n, lo, hi)
        if lo > hi then lo, hi = hi, lo end
        return _oc(n, lo, hi)
    end)

    local patched = false

    -- Strategy 1: hookfunction — replaces the C closure in-place
    if not patched and type(hookfunction) == "function" then
        local ok = pcall(hookfunction, _oc, _safe)
        if ok then patched = true; print("[ClampPatch] hookfunction succeeded") end
    end

    -- Strategy 2: game environment math table (getrenv)
    if not patched and type(getrenv) == "function" then
        pcall(function()
            local renv = getrenv()
            if renv and type(renv.math) == "table" then
                renv.math.clamp = _safe
                patched = true
                print("[ClampPatch] getrenv().math.clamp patched")
            end
        end)
    end

    -- Strategy 3: rawset bypasses metatables
    if not patched then
        local ok = pcall(rawset, math, "clamp", _safe)
        if ok and math.clamp ~= _oc then
            patched = true
            print("[ClampPatch] rawset(math) succeeded")
        end
    end

    -- Strategy 4: direct assignment
    if not patched then
        pcall(function() math.clamp = _safe end)
        if math.clamp ~= _oc then
            patched = true
            print("[ClampPatch] direct math.clamp assignment succeeded")
        end
    end

    -- Strategy 5: getgc upvalue scan (last resort — catches cached locals)
    if not patched then
        task.spawn(function()
            task.wait(2)
            local ok, gc = pcall(getgc, false)
            if not ok or type(gc) ~= "table" then return end
            local count = 0
            for _, fn in ipairs(gc) do
                if type(fn) ~= "function" then continue end
                for i = 1, 60 do
                    local ok2, name, val = pcall(debug.getupvalue, fn, i)
                    if not ok2 or name == nil then break end
                    if rawequal(val, _oc) then
                        pcall(debug.setupvalue, fn, i, _safe)
                        count = count + 1
                    end
                end
            end
            if count > 0 then
                print("[ClampPatch] getgc patched", count, "upvalue(s)")
            else
                warn("[ClampPatch] All strategies exhausted — BulletWeapon:428 may still error")
            end
        end)
    end
end

-- ============================================================================
-- GRAVEL FEATURE HELPERS
-- ============================================================================
local VirtualUser   = game:GetService("VirtualUser")
local TweenService  = game:GetService("TweenService")
local HttpService   = game:GetService("HttpService")
local VIM           = game:GetService("VirtualInputManager")

local function GV_isTeammate(p)
    if not p or p == plr then return false end
    if not cfg.TeamCheck then return false end
    if typeof(p) ~= "Instance" or not p:IsA("Player") then return false end
    return TC_isTeammate(p)
end

local function GV_hasForcefield(char)
    if not char then return false end
    if char:FindFirstChildOfClass("ForceField") then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and (hum.MaxHealth == math.huge or hum.Health == math.huge) then return true end
    return false
end

local function GV_getChar(target)
    if not target then return nil end
    if typeof(target) == "Instance" and target:IsA("Player") then return target.Character end
    if typeof(target) == "Instance" and target:IsA("Model") then return target end
    return nil
end

local function GV_isAlive(target)
    local char = GV_getChar(target)
    if not char then return false end
    local h = char:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function GV_canTarget(target)
    if target == plr then return false end
    -- TC_isTeammate runs the 5-layer universal check (cached per frame).
    if cfg.TeamCheck and TC_isTeammate(target) then return false end
    if not GV_isAlive(target) then return false end
    if cfg.SA_ignoreForcefield then
        local char = GV_getChar(target)
        if char and GV_hasForcefield(char) then return false end
    end
    return true
end

-- ============================================================================
-- HITBOX EXPANSION
-- ============================================================================
-- Resize HumanoidRootPart only.
-- HRP is invisible in all standard rigs, and Motor6D joint offsets are absolute
-- CFrame values — they do NOT scale with part size — so no visual desync occurs.
-- HRP is a valid character Part so game damage RemoteEvents recognise the hit.
local HB_expanded = {}
local HB_originals = {}

local function HB_remove(p)
    local d = HB_originals[p]
    if d and d.part and d.part.Parent then
        pcall(function()
            d.part.Size       = d.size
            d.part.CanCollide = false
        end)
    end
    HB_originals[p] = nil
    HB_expanded[p]  = nil
end

local function HB_apply(p)
    if p == plr then return end
    local char = GV_getChar(p)
    if not char then HB_remove(p); return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then HB_remove(p); return end

    if not HB_originals[p] or HB_originals[p].part ~= hrp then
        HB_originals[p] = { part = hrp, size = hrp.Size }
    end
    HB_expanded[p] = hrp

    local sz = cfg.HB_Size
    pcall(function()
        hrp.Size       = Vector3.new(sz, sz, sz)
        hrp.CanCollide = false
    end)
end

local function HB_applyAll()
    if not cfg.HB_Enabled then
        for p in pairs(HB_expanded) do HB_remove(p) end
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if GV_canTarget(p) then
            HB_apply(p)
        else
            HB_remove(p)
        end
    end
end

RunService.Heartbeat:Connect(function()
    if cfg.HB_Enabled then HB_applyAll() end
end)

Players.PlayerRemoving:Connect(function(p) HB_remove(p) end)

-- ============================================================================
-- AUTO FARM
-- ============================================================================
local AF_loop       = nil
local AF_origPos    = {}
local AF_completed  = {}
local AF_curTarget  = nil

local function AF_restoreTarget(target)
    local saved = AF_origPos[target]
    if not saved then return end
    local char = GV_getChar(target)
    local root = char and (char:FindFirstChild("HumanoidRootPart"))
    if root then pcall(function() root.CFrame = saved end) end
    AF_origPos[target] = nil
end

local _AF_Params = RaycastParams.new()
_AF_Params.FilterType = Enum.RaycastFilterType.Exclude

local function AF_canSee(target)
    if not cfg.AF_WallCheck then return true end
    local char = GV_getChar(target)
    local myChar = plr.Character
    if not char or not myChar then return false end
    local tp = (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
    local mp = (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
    if not tp or not mp then return false end
    local dir = tp.Position - mp.Position
    local ignores = {myChar}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(ignores, p.Character) end
    end
    _AF_Params.FilterDescendantsInstances = ignores
    local result = Workspace:Raycast(mp.Position, dir, _AF_Params)
    if result then
        local dist = (result.Position - mp.Position).Magnitude
        if dist < dir.Magnitude - 2 then return false end
    end
    return true
end

local function AF_getTargets()
    local myChar = plr.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
    if not myRoot then return {} end
    local valid = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if not GV_canTarget(p) then continue end
        if AF_completed[p] then continue end
        local char = GV_getChar(p)
        if not char then continue end
        if GV_hasForcefield(char) then continue end
        local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
        if not root then continue end
        local dist = (myRoot.Position - root.Position).Magnitude
        if dist > cfg.AF_MaxRange then continue end
        if not AF_canSee(p) then continue end
        table.insert(valid, { target = p, dist = dist })
    end
    table.sort(valid, function(a, b) return a.dist < b.dist end)
    local out = {}
    for _, v in ipairs(valid) do table.insert(out, v.target) end
    return out
end

local function AF_tpTarget(target)
    local char = GV_getChar(target)
    local myChar = plr.Character
    if not char or not myChar then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local camCF = Camera.CFrame
    local targetPos = camCF.Position + camCF.LookVector * cfg.AF_Distance
    targetPos = targetPos + Vector3.new(0, cfg.AF_VerticalOffset, 0)
    if not AF_origPos[target] then
        AF_origPos[target] = root.CFrame
    end
    pcall(function()
        root.CFrame = CFrame.new(targetPos, camCF.Position)
    end)
    return true
end

local function AF_stop()
    if AF_loop then AF_loop:Disconnect(); AF_loop = nil end
    for t in pairs(AF_origPos) do AF_restoreTarget(t) end
    AF_origPos   = {}
    AF_completed = {}
    AF_curTarget = nil
    cfg.AF_Enabled = false
end

local function AF_start()
    if AF_loop then AF_loop:Disconnect() end
    AF_loop = RunService.Heartbeat:Connect(function()
        if not cfg.AF_Enabled or not plr.Character then
            AF_stop(); return
        end
        local targets = AF_getTargets()
        if #targets == 0 then AF_curTarget = nil; return end
        if AF_curTarget then
            if not GV_isAlive(AF_curTarget) or AF_completed[AF_curTarget] then
                AF_restoreTarget(AF_curTarget)
                AF_completed[AF_curTarget] = true
                AF_curTarget = nil
            end
        end
        if not AF_curTarget then
            for _, t in ipairs(targets) do
                if not AF_completed[t] then
                    AF_curTarget = t
                    break
                end
            end
        end
        if AF_curTarget then
            AF_tpTarget(AF_curTarget)
        end
    end)
end

-- ============================================================================
-- BOT (AUTO ATTACK)
-- ============================================================================
local BOT_lastAttack = 0
local BOT_attackCooldown = 0.2

local _BOT_Params = RaycastParams.new()
_BOT_Params.FilterType = Enum.RaycastFilterType.Exclude

local function BOT_getTarget()
    local myChar = plr.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local best, bestDist = nil, cfg.BOT_AttackRange
    for _, p in ipairs(Players:GetPlayers()) do
        if not GV_canTarget(p) then continue end
        local char = GV_getChar(p)
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end
        if cfg.BOT_WallCheck then
            _BOT_Params.FilterDescendantsInstances = {myChar}
            local dir = root.Position - myRoot.Position
            local res = Workspace:Raycast(myRoot.Position, dir, _BOT_Params)
            if res and (res.Position - myRoot.Position).Magnitude < dir.Magnitude - 2 then continue end
        end
        local dist = (root.Position - myRoot.Position).Magnitude
        if dist < bestDist then best = p; bestDist = dist end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    if not cfg.BOT_Enabled then return end
    local now = tick()
    if now - BOT_lastAttack < BOT_attackCooldown then return end
    BOT_lastAttack = now
    local target = BOT_getTarget()
    if not target then return end
    local myChar = plr.Character
    if not myChar then return end
    local hum = myChar:FindFirstChildOfClass("Humanoid")
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not hum or not myRoot then return end
    local tChar = GV_getChar(target)
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
    if tRoot then
        hum.AutoRotate = false
        myRoot.CFrame = myRoot.CFrame:Lerp(
            CFrame.new(myRoot.Position, Vector3.new(tRoot.Position.X, myRoot.Position.Y, tRoot.Position.Z)),
            cfg.BOT_RotateSpeed
        )
        hum:MoveTo((tRoot.CFrame * CFrame.new(-3,0,0)).Position)
    end
    -- Fire tool
    local tool = myChar:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
        if tChar and tRoot and (tRoot.Position - myRoot.Position).Magnitude <= cfg.BOT_MeleeReach then
            for _, part in ipairs(tChar:GetChildren()) do
                if part:IsA("BasePart") and tool:FindFirstChild("Handle") then
                    pcall(function()
                        firetouchinterest(tool.Handle, part, 0)
                        firetouchinterest(tool.Handle, part, 1)
                    end)
                end
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if not cfg.BOT_Enabled then
        local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.AutoRotate = true end
    end
end)

-- ============================================================================
-- REACH (FireTouchInterest)
-- ============================================================================
local RC_autoSwingConn = nil
local RC_visPart       = nil

local function RC_destroyVis()
    if RC_visPart then pcall(function() RC_visPart:Destroy() end); RC_visPart = nil end
end

local function RC_getVisPart()
    if RC_visPart and RC_visPart.Parent then return RC_visPart end
    local p = Instance.new("Part")
    p.Name = "RC_Visualizer"; p.Anchored = true; p.CanCollide = false
    p.CanQuery = false; p.CanTouch = false; p.CastShadow = false
    p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = Workspace
    RC_visPart = p
    return p
end

local RC_Materials = {
    ForceField    = Enum.Material.ForceField,
    Neon          = Enum.Material.Neon,
    SmoothPlastic = Enum.Material.SmoothPlastic,
    Glass         = Enum.Material.Glass,
}

RunService.RenderStepped:Connect(function()
    if not cfg.RC_Enabled then RC_destroyVis(); return end
    local char = plr.Character
    if not char then RC_destroyVis(); return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then RC_destroyVis(); return end
    local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("Part")
    if not handle then RC_destroyVis(); return end
    -- Apply FireTouchInterest to targets in range
    for _, p in ipairs(Players:GetPlayers()) do
        if GV_canTarget(p) then
            local tChar = GV_getChar(p)
            if tChar then
                local tRoot = tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("Head")
                if tRoot and (tRoot.Position - handle.Position).Magnitude <= cfg.RC_Distance then
                    pcall(function() firetouchinterest(handle, tRoot, 0) end)
                    pcall(function() firetouchinterest(handle, tRoot, 1) end)
                end
            end
        end
    end
    -- Visualizer
    if cfg.RC_Visualizer then
        local vp = RC_getVisPart()
        vp.Material = RC_Materials[cfg.RC_VisMaterial] or Enum.Material.ForceField
        vp.Color = cfg.RC_VisColor
        vp.Transparency = cfg.RC_VisTransparency
        if cfg.RC_Type == "Sphere" then
            vp.Shape = Enum.PartType.Ball
            vp.Size = Vector3.new(cfg.RC_Distance*2, cfg.RC_Distance*2, cfg.RC_Distance*2)
            vp.CFrame = handle.CFrame
        else
            vp.Shape = Enum.PartType.Block
            vp.Size = Vector3.new(cfg.RC_Distance, 0.2, cfg.RC_Distance)
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then vp.CFrame = CFrame.new(root.Position) * CFrame.new(0,-2.5,0) end
        end
    else
        RC_destroyVis()
    end
end)

-- Auto-swing
local function RC_startAutoSwing()
    if RC_autoSwingConn then RC_autoSwingConn:Disconnect() end
    RC_autoSwingConn = RunService.Heartbeat:Connect(function()
        if not cfg.RC_AutoSwing or not cfg.RC_Enabled then return end
        local char = plr.Character
        if not char then return end
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then pcall(function() tool:Activate() end) end
    end)
end
local function RC_stopAutoSwing()
    if RC_autoSwingConn then RC_autoSwingConn:Disconnect(); RC_autoSwingConn = nil end
end
-- RC_startAutoSwing is called by the UI toggle and keybind only — do not start unconditionally.

-- ============================================================================
-- ANIMATION SYSTEM
-- ============================================================================
local ANIM_track     = nil
local ANIM_loopConn  = nil

local function ANIM_stop()
    if ANIM_track then pcall(function() ANIM_track:Stop(); ANIM_track:Destroy() end); ANIM_track = nil end
    if ANIM_loopConn then ANIM_loopConn:Disconnect(); ANIM_loopConn = nil end
end

local function ANIM_play(animId)
    ANIM_stop()
    if not cfg.ANIM_Enabled or not animId or animId == "" then return end
    local char = plr.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(animId)
    local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
    if not ok or not track then return end
    ANIM_track = track
    track:AdjustSpeed(cfg.ANIM_Speed)
    track.Looped = true
    track.Priority = Enum.AnimationPriority.Core
    track:Play()
    cfg.ANIM_CurrentId = tostring(animId)
    ANIM_loopConn = hum.Died:Connect(function()
        task.wait(0.1)
        if cfg.ANIM_Enabled then ANIM_play(animId) end
    end)
end

