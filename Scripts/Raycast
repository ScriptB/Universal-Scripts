-- Animations ──────────────────────────────────────────────────────────────
_safeUI("Animations", function()
    ANIM_Group:AddToggle("ANIM_Enabled", {
        Text     = "Enable Animation",
        Default  = cfg.ANIM_Enabled,
        Callback = function(v)
            cfg.ANIM_Enabled = v
            _sfx(v and SFX.Enable or SFX.Disable, 0.3)
            if not v then ANIM_stop() else ANIM_play(cfg.ANIM_CurrentId) end
        end,
    })
    pcall(function()
        ANIM_Group:AddSlider("ANIM_Speed", {
            Text     = "Playback Speed (x/10)",
            Default  = math.floor(cfg.ANIM_Speed * 10),
            Min      = 1, Max = 50,
            Rounding = false,
            Callback = function(v)
                cfg.ANIM_Speed = v / 10
                if ANIM_track then pcall(function() ANIM_track:AdjustSpeed(cfg.ANIM_Speed) end) end
            end,
        })
    end)
    ANIM_Group:AddInput("ANIM_CurrentId", {
        Text     = "Animation ID",
        Default  = cfg.ANIM_CurrentId,
        Finished = true,
        Callback = function(v) cfg.ANIM_CurrentId = v; if cfg.ANIM_Enabled then ANIM_play(v) end end,
    })
    ANIM_Group:AddButton({ Text = "Play", Callback = function()
        if cfg.ANIM_Enabled then ANIM_play(cfg.ANIM_CurrentId) end
    end })
    ANIM_Group:AddButton({ Text = "Stop", Callback = function() ANIM_stop() end })
    ANIM_Group:AddDivider()
    local function makePreset(group, id, label)
        group:AddButton({ Text = label .. " (" .. id .. ")", Callback = function()
            cfg.ANIM_CurrentId = id
            local _obj = AxiUI.Flags["ANIM_CurrentId_obj"]
            if _obj and _obj.Set then _obj:Set(id) end
            if cfg.ANIM_Enabled then ANIM_play(id) end
        end })
    end
    ANIM_Group:AddLabel("R6 Presets:")
    for _, id in ipairs(ANIM_R6_Presets) do makePreset(ANIM_Group, id, "R6") end
    ANIM_Group:AddLabel("R15 Presets:")
    for _, id in ipairs(ANIM_R15_Presets) do makePreset(ANIM_Group, id, "R15") end
end)

