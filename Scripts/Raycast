-- ============================================================================
-- AUTO RESPAWN (respawn to death position)
-- ============================================================================
local AR_deathPos   = nil
local AR_diedConn   = nil
local AR_addedConn  = nil

local function AR_setup()
    if AR_diedConn then AR_diedConn:Disconnect() end
    if AR_addedConn then AR_addedConn:Disconnect() end
    if not cfg.UTIL_AutoRespawn then return end
    local function trackChar(char)
        local hum = char:WaitForChild("Humanoid", 5)
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return end
        AR_diedConn = hum.Died:Connect(function()
            if cfg.UTIL_AutoRespawn then AR_deathPos = root.CFrame end
        end)
    end
    if plr.Character then trackChar(plr.Character) end
    AR_addedConn = plr.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        if cfg.UTIL_AutoRespawn and AR_deathPos then
            local root = char:WaitForChild("HumanoidRootPart", 5)
            if root then root.CFrame = AR_deathPos end
            AR_deathPos = nil
        end
        trackChar(char)
    end)
end

-- ============================================================================
-- FAST SPAWN
-- ============================================================================
local function FS_doRespawn()
    if not cfg.UTIL_FastSpawn then return end
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local savedCF    = hrp.CFrame
    local savedCamCF = Camera.CFrame
    pcall(function()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Dead) end
        char:ClearAllChildren()
        local temp = Instance.new("Model"); temp.Parent = Workspace
        plr.Character = temp
        task.wait()
        plr.Character = char
        temp:Destroy()
    end)
    -- CharacterAdded:Wait() is intentionally omitted: the client-side character
    -- swap above does not fire a server-side CharacterAdded event, so the wait
    -- would block forever and leak the thread.
end

-- ============================================================================
-- REMOVE FACE DECAL
-- ============================================================================
local function GV_removeFace(target)
    local char = GV_getChar(target)
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    for _, child in ipairs(head:GetChildren()) do
        if child:IsA("Decal") then
            local nameL = child.Name:lower()
            local _texOk, _tex = pcall(function() return child.Texture end)
            local texL = tostring(_texOk and _tex or ""):lower()
            if nameL:find("face") or texL:find("face") then
                pcall(function() child:Destroy() end)
            end
        end
    end
end

-- ============================================================================
-- LOW RENDER
-- ============================================================================
local function _disableEffect(v)
    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
        pcall(function() v.Enabled = false end)
    end
end

local function GV_applyLowRender()
    if not cfg.UTIL_LowRender then return end
    pcall(function()
        local lighting = game:GetService("Lighting")
        lighting.GlobalShadows = false
        lighting.Technology    = Enum.Technology.Legacy
        settings().Rendering.QualityLevel = 1
        for _, v in ipairs(Workspace:GetDescendants()) do _disableEffect(v) end
    end)
    -- Suppress effects added to the workspace after this call.
    Workspace.DescendantAdded:Connect(function(v)
        if cfg.UTIL_LowRender then _disableEffect(v) end
    end)
end

-- ============================================================================
-- KEYBIND SYSTEM
-- ============================================================================
local KB_holdingMod = false

local function KB_shouldFire()
    if not cfg.KB_Enabled then return false end
    if cfg.KB_HoldMode then return KB_holdingMod end
    return true
end

local function KB_keyToEnum(keyStr)
    local ok, v = pcall(function() return Enum.KeyCode[keyStr] end)
    return ok and v or nil
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    local keyMod = KB_keyToEnum(cfg.KB_HoldKey)
    if keyMod and input.KeyCode == keyMod then KB_holdingMod = true end
    if not KB_shouldFire() then return end

    local ksa  = KB_keyToEnum(cfg.KB_SilentAim)
    local kab  = KB_keyToEnum(cfg.KB_Aimbot)
    local kaf  = KB_keyToEnum(cfg.KB_AutoFarm)
    local kaa  = KB_keyToEnum(cfg.KB_AntiAim)
    local khb  = KB_keyToEnum(cfg.KB_Hitbox)
    local kesp = KB_keyToEnum(cfg.KB_ESP)
    local kcl  = KB_keyToEnum(cfg.KB_Client)
    local ksaw = KB_keyToEnum(cfg.KB_SAWallCheck)
    local kabw = KB_keyToEnum(cfg.KB_ABWallCheck)

    if ksa and input.KeyCode == ksa then
        cfg.SA_Enabled = not cfg.SA_Enabled
    elseif kab and input.KeyCode == kab then
        cfg.AB_Enabled = not cfg.AB_Enabled
    elseif kaf and input.KeyCode == kaf then
        cfg.AF_Enabled = not cfg.AF_Enabled
        if cfg.AF_Enabled then AF_start() else AF_stop() end
    elseif kaa and input.KeyCode == kaa then
        cfg.AA_Enabled = not cfg.AA_Enabled
        if not cfg.AA_Enabled then AA_restorePos() end
    elseif khb and input.KeyCode == khb then
        cfg.HB_Enabled = not cfg.HB_Enabled
        if not cfg.HB_Enabled then for p in pairs(HB_expanded) do HB_remove(p) end end
    elseif kesp and input.KeyCode == kesp then
        cfg.ESP_Enabled = not cfg.ESP_Enabled
    elseif kcl and input.KeyCode == kcl then
        cfg.CMBC_Enabled = not cfg.CMBC_Enabled
    elseif ksaw and input.KeyCode == ksaw then
        cfg.SA_Wallcheck = not cfg.SA_Wallcheck
    elseif kabw and input.KeyCode == kabw then
        cfg.AB_VisibleCheck = not cfg.AB_VisibleCheck
    end
end)

UserInputService.InputEnded:Connect(function(input, gpe)
    if gpe then return end
    local keyMod = KB_keyToEnum(cfg.KB_HoldKey)
    if keyMod and input.KeyCode == keyMod then KB_holdingMod = false end
end)

-- ============================================================================
-- QUICKTOGGLES MOBILE GUI
-- ============================================================================
-- Shared flag set by AxiUI.OnUnload so the polling loop exits cleanly.
local _mainRunning = true
local QT_gui = nil

local function QT_destroy()
    if QT_gui and QT_gui.Parent then QT_gui:Destroy() end
    QT_gui = nil
end

local function QT_create()
    QT_destroy()
    local sg = Instance.new("ScreenGui")
    sg.Name = "QT_Gravel"; sg.ResetOnSpawn = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent = plr:WaitForChild("PlayerGui")
    QT_gui = sg

    local function makeButton(name, posX, posY, getter, setter)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0,120,0,40); frame.Position = UDim2.new(0,posX,0,posY)
        frame.BackgroundColor3 = Color3.fromRGB(25,25,25); frame.BorderSizePixel = 0
        frame.Active = true; frame.Draggable = true; frame.Parent = sg
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0,6)
        local lbl = Instance.new("TextLabel", frame)
        lbl.Size = UDim2.new(1,-50,1,0); lbl.Position = UDim2.new(0,8,0,0)
        lbl.BackgroundTransparency = 1; lbl.Text = name
        lbl.TextColor3 = Color3.fromRGB(200,200,200); lbl.Font = Enum.Font.GothamSemibold
        lbl.TextSize = 13; lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextYAlignment = Enum.TextYAlignment.Center
        local bgToggle = Instance.new("Frame", frame)
        bgToggle.Size = UDim2.new(0,38,0,18); bgToggle.Position = UDim2.new(1,-44,0.5,-9)
        bgToggle.BorderSizePixel = 0; bgToggle.ClipsDescendants = false
        bgToggle.BackgroundColor3 = getter() and Color3.fromRGB(0,100,0) or Color3.fromRGB(15,15,15)
        Instance.new("UICorner", bgToggle).CornerRadius = UDim.new(0,9)
        local circle = Instance.new("Frame", bgToggle)
        circle.Size = UDim2.new(0,16,0,16); circle.BorderSizePixel = 0
        circle.BackgroundColor3 = getter() and Color3.fromRGB(0,170,0) or Color3.fromRGB(60,60,60)
        circle.Position = getter() and UDim2.new(1,-18,0,1) or UDim2.new(0,1,0,1)
        Instance.new("UICorner", circle).CornerRadius = UDim.new(1,0)
        local twi = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        local btn = Instance.new("TextButton", frame)
        btn.Size = UDim2.new(1,0,1,0); btn.BackgroundTransparency = 1; btn.Text = ""
        btn.ZIndex = 10; btn.Parent = frame
        btn.MouseButton1Click:Connect(function()
            local v = not getter(); setter(v)
            local onC  = v and Color3.fromRGB(0,170,0)  or Color3.fromRGB(60,60,60)
            local bgC  = v and Color3.fromRGB(0,100,0)  or Color3.fromRGB(15,15,15)
            local posC = v and UDim2.new(1,-18,0,1) or UDim2.new(0,1,0,1)
            TweenService:Create(circle, twi, {BackgroundColor3=onC, Position=posC}):Play()
            TweenService:Create(bgToggle, twi, {BackgroundColor3=bgC}):Play()
        end)
    end

    local sp = 130
    makeButton("Silent Aim", 10, 10, function() return cfg.SA_Enabled end, function(v) cfg.SA_Enabled=v end)
    makeButton("Hitbox",     10+sp, 10, function() return cfg.HB_Enabled end, function(v) cfg.HB_Enabled=v end)
    makeButton("Anti Aim",   10+sp*2, 10, function() return cfg.AA_Enabled end, function(v) cfg.AA_Enabled=v end)
    makeButton("Aimbot",     10+sp*3, 10, function() return cfg.AB_Enabled end, function(v) cfg.AB_Enabled=v end)
    makeButton("Client",     10, 60, function() return cfg.CMBC_Enabled end, function(v) cfg.CMBC_Enabled=v end)
    makeButton("ESP",        10+sp, 60, function() return cfg.ESP_Enabled end, function(v) cfg.ESP_Enabled=v end)
    makeButton("Auto Farm",  10+sp*2, 60, function() return cfg.AF_Enabled end, function(v)
        cfg.AF_Enabled=v; if v then AF_start() else AF_stop() end
    end)
end

-- Watch QuickToggles toggle — stops when AxiUI unloads.
task.spawn(function()
    while _mainRunning do
        if cfg.UTIL_QuickToggles then
            if not QT_gui or not QT_gui.Parent then QT_create() end
        else
            if QT_gui and QT_gui.Parent then QT_destroy() end
        end
        task.wait(0.5)
    end
end)

-- ============================================================================
-- CHARACTER LIFECYCLE
-- Properly gates hooks during respawn and restores CameraSubject exactly once.
-- Writing CameraSubject every RenderStepped frame races with Roblox's own
-- CameraModule early-render callback → "Instance expected, got string" errors.
-- ============================================================================
local function onCharacterRemoving()
    respawnLock            = true
    cfg.SA_currentTarget   = nil
    cfg.AA_OriginalPos     = nil
    cfg.AA_IsTeleported    = false
    SA_ResetTargetCache()
    VBC_destroy()
    AA_stopCamLock()
end

local function onCharacterAdded(char)
    local hum = char:WaitForChild("Humanoid", 5)
    respawnLock = false
    SA_ResetTargetCache()
    if hum then
        local cam = Workspace.CurrentCamera
        if typeof(cam) == "Instance" and cam:IsA("Camera") then
            Camera                  = cam
            GetPartsObscuringTarget = cam.GetPartsObscuringTarget
            cam.CameraSubject       = hum
        end
    end
end

if plr.Character then
    task.spawn(onCharacterAdded, plr.Character)
end
plr.CharacterRemoving:Connect(onCharacterRemoving)
plr.CharacterAdded:Connect(onCharacterAdded)

-- Also keep Camera reference fresh when Roblox replaces CurrentCamera
-- (e.g. after a teleport). Guard: only accept valid Camera instances.
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    local cam = Workspace.CurrentCamera
    if typeof(cam) == "Instance" and cam:IsA("Camera") then
        Camera                  = cam
        GetPartsObscuringTarget = cam.GetPartsObscuringTarget
        SA_ResetTargetCache()
    end
end)

-- ============================================================================
-- RE-EXECUTE STARTUP STATE RESTORATION
-- Features whose state is preserved in getgenv().BC across re-executes need
-- to be re-started here because their connections and parts are torn down on
-- each execution.  Only fires when the respective config flag is already true.
-- ============================================================================
if cfg.UTIL_Airwalk    then AW_start()  end
if cfg.UTIL_Truss      then TR_start()  end
if cfg.UTIL_AutoRespawn then AR_setup() end
if cfg.AF_Enabled      then AF_start()  end

-- ============================================================================
-- UI LIBRARY  (AxiUI)
-- ============================================================================
local AxiUI
pcall(function()
    local _axirepo = "https://raw.githubusercontent.com/ScriptB/Universal-Scripts/main/AxiUI/"
    AxiUI = loadstring(game:HttpGet(_axirepo .. "AxiUI_Framework.lua"))()
    loadstring(game:HttpGet(_axirepo .. "AxiUI_ThemeManager.lua"))()
    loadstring(game:HttpGet(_axirepo .. "AxiUI_InterfaceManager.lua"))()
end)

if not AxiUI then
    warn("[Raycast | v3] AxiUI Library failed to load — tearing down hooks.")

    cfg.SA_Enabled  = false
    cfg.AB_Enabled  = false
    cfg.TB_Enabled  = false
    cfg.AA_Enabled  = false
    cfg.ESP_Enabled = false
    cfg.AK_Enabled  = false

    pcall(function() if OldIndex    then hookmetamethod(game, "__index",    OldIndex)    end end)
    pcall(function() if OldNamecall then hookmetamethod(game, "__namecall", OldNamecall) end end)

    StarterGui:SetCore("SendNotification", {
        Title    = "Raycast | v3",
        Text     = "AxiUI Library failed to load. Please re-execute.",
        Duration = 8,
    })
    return
end

-- Override accent colour only.  Do NOT override WindowBg — the pill OFF-state
-- colour is hardcoded (60,55,80) inside the Framework and requires the default
-- dark-blue-grey background (14,16,26) for adequate contrast; a near-black
-- background would make the pill invisible.
AxiUI:SetTheme({
    Accent       = Color3.fromRGB(0,   170, 255),
    AccentAlpha  = 0.40,
    AccentStrong = Color3.fromRGB(100, 210, 255),
})

-- ============================================================================
-- UI CONSTRUCTION
-- ============================================================================
-- Temporarily UNHOOK __index during UI construction to avoid overhead on
-- the many property reads that AxiUI performs while building elements.
local _savedIndexHook
if type(OldIndex) == "function" then
    pcall(function() _savedIndexHook = hookmetamethod(game, "__index", OldIndex) end)
end

-- Wrap UI construction in its own function scope.
-- Lua 5.1 allows max 200 locals per function; _RaycastMain already uses most
-- of that budget for gameplay locals, so the UI gets its own register space.
;(function()

-- ────────────────────────────────────────────────────────────────────────────
--  SFX helper
-- ────────────────────────────────────────────────────────────────────────────
local _SoundSvc  = game:GetService("SoundService")
local _DebrisSvc = game:GetService("Debris")

local SFX = {
    Enable    = 6895079853,
    Disable   = 6895079726,
    Alert     = 4590657391,
    Success   = 4590662766,
    Slider    = 7661753402,
    Select    = 6732059359,
    Info      = 6026984224,
    TabSwitch = 12222253,
}

local _sfxMuted  = false
local _masterVol = 0.4
local function _sfx(id, vol, pitch)
    if _sfxMuted or not id or id == 0 then return end
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId            = "rbxassetid://" .. tostring(id)
        s.Volume             = (vol or 0.35) * _masterVol
        s.PlaybackSpeed      = pitch or 1.0
        s.RollOffMaxDistance = 0
        s.Parent             = _SoundSvc
        s:Play()
        _DebrisSvc:AddItem(s, 3)
    end)
end

-- Flag used to stop live-update loops when AxiUI is unloaded
local _unloaded = false

-- Runs fn() inside pcall; warns in console if it throws so other sections
-- still load even when one section errors.
local function _safeUI(section, fn)
    local ok, err = pcall(fn)
    if not ok then
        warn("[Raycast|UI] " .. tostring(section) .. " failed: " .. tostring(err))
    end
end

-- ────────────────────────────────────────────────────────────────────────────
--  WINDOW
-- ────────────────────────────────────────────────────────────────────────────
local Window = AxiUI:CreateWindow({
    Title     = "Raycast | v3",
    Width     = 520,
    Height    = 500,
    ToggleKey = Enum.KeyCode.RightShift,
})

if AxiUI.Watermark      then AxiUI.Watermark:SetVisible(false); AxiUI.Watermark:Set("Raycast | v3"); AxiUI.Watermark:SetVisible(true) end
if AxiUI.KeybindOverlay then AxiUI.KeybindOverlay:SetVisible(false) end

-- ────────────────────────────────────────────────────────────────────────────
--  UNLOAD — restore hooks and destroy visual artefacts
-- ────────────────────────────────────────────────────────────────────────────
AxiUI.OnUnload = function()
    _unloaded    = true
    _mainRunning = false   -- terminates the QT polling loop
    pcall(function() hookmetamethod(game, "__index",    OldIndex) end)
    if OldNamecall then pcall(function() hookmetamethod(game, "__namecall", OldNamecall) end) end
    pcall(VBC_destroy); pcall(RC_destroyVis); pcall(QT_destroy)
    pcall(AW_stop);     pcall(TR_stop);       pcall(ANIM_stop)
    if HB_expanded then
        for p in pairs(HB_expanded) do pcall(HB_remove, p) end
    end
end

