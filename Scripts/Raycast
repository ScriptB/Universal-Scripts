    AW_part.Anchored = true; AW_part.CanCollide = true; AW_part.Parent = Workspace
    AW_conn = RunService.Heartbeat:Connect(function()
        if not cfg.UTIL_Airwalk or not AW_part or not root or not root.Parent then
            AW_stop(); return
        end
        AW_part.CFrame = root.CFrame + Vector3.new(0,-4,0)
    end)
end

